#Использовать ".."
#Использовать "./fixtures"
#Использовать asserts
#Использовать tempfiles

// Реестр зарегистрированных типов и временные файлы регистрации общие для всех потоков
// процесса: фоновые задания регистрируют типы и создают их экземпляры одновременно.

// Повторяющиеся задания работают, пока этот флаг не поднят, см. Остановлено
Перем НужноОстановиться;

// Защищает флаг НужноОстановиться
Перем БлокировкаОстановки;

&Тест
Процедура ПараллельнаяРегистрацияНеЛомаетЭкземплярыТипов() Экспорт

	Если ДвижокНеРегистрируетТипыПараллельно() Тогда
		Возврат;
	КонецЕсли;

	КоличествоТипов = 15;
	Префикс = ПрефиксТипов();

	Задания = Новый Массив;

	Для НомерЗадания = 1 По 4 Цикл
		Задания.Добавить(ЗапуститьЗадание(
			"РегистрироватьИСоздавать",
			ИмяТипа(Префикс, НомерЗадания),
			КоличествоТипов
		));
	КонецЦикла;

	ПроверитьЗадания(Задания);

	// После регистрации типа с номером N задание создаёт экземпляры типов с 1 по N
	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.Результат).Равно(ПовторовСоздания() * КоличествоТипов * (КоличествоТипов + 1) / 2);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура РегистрацияНеУдаляетЧужиеВременныеФайлы() Экспорт

	ЧужойФайл = ВременныеФайлы.СоздатьФайл("txt");

	ЗарегистрироватьТип(ПрефиксТипов(), 1);

	ЧужойФайлНаМесте = Новый Файл(ЧужойФайл).Существует();

	ВременныеФайлы.УдалитьФайл(ЧужойФайл);

	Ожидаем.Что(ЧужойФайлНаМесте, "Регистрация типа удалила временный файл, созданный другим кодом").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РегистрацияНеМешаетСозданиюЭкземпляровЗарегистрированныхТипов() Экспорт

	Если ДвижокНеРегистрируетТипыПараллельно() Тогда
		Возврат;
	КонецЕсли;

	КоличествоГотовыхТипов = 5;
	ПрефиксГотовыхТипов = ПрефиксТипов();

	Для Номер = 1 По КоличествоГотовыхТипов Цикл
		ЗарегистрироватьТип(ПрефиксГотовыхТипов, Номер);
	КонецЦикла;

	СброситьОстановку();

	Создающие = Новый Массив;

	Для НомерЗадания = 1 По 3 Цикл
		Создающие.Добавить(ЗапуститьЗадание("СоздаватьЭкземпляры", ПрефиксГотовыхТипов, КоличествоГотовыхТипов));
	КонецЦикла;

	ДождатьсяЗаданий(ЗапуститьЗадание("Регистрировать", ПрефиксТипов(), 60), Создающие);

КонецПроцедуры

// Регистрация типа компилирует модуль, поэтому за тест выше словари реестра
// перестраиваются считанные разы, и чтение без блокировки редко попадает на перестройку.
// Здесь реестр пишется напрямую, тысячами записей, пока задания читают запись готового типа.
&Тест
Процедура ЗаписьВРеестрНеЛомаетЧтениеИзНего() Экспорт

	ПрефиксГотовогоТипа = ПрефиксТипов();

	ЗаписатьВРеестр(ПрефиксГотовогоТипа, 0);

	СброситьОстановку();

	Читающие = Новый Массив;

	Для НомерЗадания = 1 По 4 Цикл
		Читающие.Добавить(ЗапуститьЗадание("ЧитатьРеестр", ПрефиксГотовогоТипа, 0));
	КонецЦикла;

	ДождатьсяЗаданий(ЗапуститьЗадание("ПисатьВРеестр", ПрефиксТипов(), 10000), Читающие);

КонецПроцедуры

#Область Задания

// Регистрирует типы по одному и после каждой регистрации создаёт экземпляры
// всех уже зарегистрированных типов задания.
//
// Параметры:
//   Префикс - Строка - Префикс имён типов задания
//   КоличествоТипов - Число - Сколько типов зарегистрировать
//
//  Возвращаемое значение:
//   Число - Количество созданных экземпляров
//
Функция РегистрироватьИСоздавать(Знач Префикс, Знач КоличествоТипов) Экспорт

	Создано = 0;

	Для Номер = 1 По КоличествоТипов Цикл

		ЗарегистрироватьТип(Префикс, Номер);

		Для Повтор = 1 По ПовторовСоздания() Цикл
			Для НомерТипа = 1 По Номер Цикл
				ПроверитьЭкземпляр(Префикс, НомерТипа);
				Создано = Создано + 1;
			КонецЦикла;
		КонецЦикла;

	КонецЦикла;

	Возврат Создано;

КонецФункции

// Регистрирует типы и проверяет экземпляр каждого.
//
// Параметры:
//   Префикс - Строка - Префикс имён типов задания
//   КоличествоТипов - Число - Сколько типов зарегистрировать
//
Процедура Регистрировать(Знач Префикс, Знач КоличествоТипов) Экспорт

	Для Номер = 1 По КоличествоТипов Цикл
		ЗарегистрироватьТип(Префикс, Номер);
		ПроверитьЭкземпляр(Префикс, Номер);
	КонецЦикла;

КонецПроцедуры

// Создаёт экземпляры зарегистрированных типов по кругу, пока задания не остановят.
//
// Параметры:
//   Префикс - Строка - Префикс имён зарегистрированных типов
//   КоличествоТипов - Число - Сколько типов зарегистрировано
//
//  Возвращаемое значение:
//   Число - Количество созданных экземпляров
//
Функция СоздаватьЭкземпляры(Знач Префикс, Знач КоличествоТипов) Экспорт

	Создано = 0;

	Пока Не Остановлено() Цикл

		Для Номер = 1 По КоличествоТипов Цикл
			ПроверитьЭкземпляр(Префикс, Номер);
			Создано = Создано + 1;
		КонецЦикла;

	КонецЦикла;

	Возврат Создано;

КонецФункции

// Пишет в реестр записи новых типов, как это делает регистрация.
//
// Параметры:
//   Префикс - Строка - Префикс имён типов
//   КоличествоТипов - Число - Сколько записей сделать
//
Процедура ПисатьВРеестр(Знач Префикс, Знач КоличествоТипов) Экспорт

	Для Номер = 1 По КоличествоТипов Цикл
		ЗаписатьВРеестр(Префикс, Номер);
	КонецЦикла;

КонецПроцедуры

// Читает запись типа из реестра, как это делает экземпляр типа, пока задания не остановят.
//
// Параметры:
//   Префикс - Строка - Префикс имени типа
//   Номер - Число - Номер типа
//
//  Возвращаемое значение:
//   Число - Сколько раз запись прочитана
//
Функция ЧитатьРеестр(Знач Префикс, Знач Номер) Экспорт

	Прочитано = 0;

	Пока Не Остановлено() Цикл
		ПроверитьЗаписьРеестра(Префикс, Номер);
		Прочитано = Прочитано + 1;
	КонецЦикла;

	Возврат Прочитано;

КонецФункции

#КонецОбласти

Процедура ЗарегистрироватьТип(Префикс, Номер)

	Построитель = Новый ПостроительДекоратора(Тип("МойКлассСПараметризованнымКонструктором"))
		.ЗначениеПараметраКонструктораПоТипу(Номер)
		.Поле(Новый Поле("Номер").ЗначениеПоУмолчанию(Номер))
		.Метод(Новый Метод("НомерТипа").Публичный().ТелоМетода("Возврат Номер;"));

	Построитель.ЗарегистрироватьВСистемеТипов(ИмяТипа(Префикс, Номер));

КонецПроцедуры

// До OneScript 2.3 сам движок не выдерживает регистрацию типа, пока другие потоки создают
// и сравнивают объекты, - декоратор это не исправит, и там такие тесты не выполняются.
// В ночных сборках 2.3 пока нет EvilBeaver/OneScript#1762: первое создание объектов разных
// типов из нескольких потоков сразу ломает кеш фабрик типов движка.
//
//  Возвращаемое значение:
//   Булево - Истина, если тест нужно пропустить
//
Функция ДвижокНеРегистрируетТипыПараллельно()

	Версия  = Новый СистемнаяИнформация().Версия;
	Номера  = СтрРазделить(Версия, ".");
	Старший = Число(Номера[0]);
	Младший = Число(Номера[1]);

	Если (Старший > 2 Или Старший = 2 И Младший >= 3) И СтрНайти(Версия, "-dev") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Сообщить(СтрШаблон("Тест пропущен: в OneScript %1 типы нельзя регистрировать параллельно с созданием объектов", Версия));

	Возврат Истина;

КонецФункции

// Значение поля по умолчанию и параметр конструктора исходного объекта экземпляр
// получает из реестра зарегистрированных типов.
Процедура ПроверитьЭкземпляр(Префикс, Номер)

	Экземпляр = Новый(ИмяТипа(Префикс, Номер));

	Если Экземпляр.НомерТипа() <> Номер Или Экземпляр.Парам1 <> Номер Тогда
		ВызватьИсключение СтрШаблон(
			"Экземпляр типа %1 получил чужие значения: поле Номер = %2, Парам1 = %3",
			ИмяТипа(Префикс, Номер),
			Экземпляр.НомерТипа(),
			Экземпляр.Парам1
		);
	КонецЕсли;

КонецПроцедуры

// Все значения записи - номер типа: так запись другого типа не сойдёт за свою.
Процедура ЗаписатьВРеестр(Префикс, Номер)

	Имя = ИмяТипа(Префикс, Номер);

	Рецепт = Новый Массив;
	Рецепт.Добавить(Номер);

	ДекораторКонтекстТиповСлужебный.УстановитьИнстансИсходногоОбъекта(Имя, Ложь, Номер);
	ДекораторКонтекстТиповСлужебный.УстановитьРецепт(Имя, Рецепт);
	ДекораторКонтекстТиповСлужебный.УстановитьЗначениеПоляПоУмолчанию(Имя, "Номер", Номер);

КонецПроцедуры

Процедура ПроверитьЗаписьРеестра(Префикс, Номер)

	Имя = ИмяТипа(Префикс, Номер);

	Описание = ДекораторКонтекстТиповСлужебный.ОписаниеИсходногоОбъекта(Имя);
	Рецепт   = ДекораторКонтекстТиповСлужебный.Рецепт(Имя);
	Значение = ДекораторКонтекстТиповСлужебный.ЗначениеПоляПоУмолчанию(Имя, "Номер");

	Если Описание = Неопределено
		Или Описание.ИсходныйОбъект <> Номер
		Или Рецепт.Количество() <> 1
		Или Рецепт[0] <> Номер
		Или Значение <> Номер Тогда
		ВызватьИсключение СтрШаблон("Реестр отдал для типа %1 не его запись", Имя);
	КонецЕсли;

КонецПроцедуры

Функция ЗапуститьЗадание(ИмяМетода, Префикс, Число)

	Параметры = Новый Массив;
	Параметры.Добавить(Префикс);
	Параметры.Добавить(Число);

	// Каждому заданию свой поток: в пуле задания могли бы выполниться по очереди
	Возврат ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, Параметры, Истина);

КонецФункции

// Дожидается задания, пока работают повторяющиеся задания, останавливает их и проверяет все.
//
// Параметры:
//   Задание - ФоновоеЗадание - Задание, на время которого работают повторяющиеся
//   Повторяющиеся - Массив из ФоновоеЗадание - Задания, которые повторяют действие до остановки
//                   и возвращают число повторов
//
Процедура ДождатьсяЗаданий(Задание, Повторяющиеся)

	Задание.ОжидатьЗавершения(ТаймаутЗадания());
	Остановить();

	Задания = Новый Массив;
	Задания.Добавить(Задание);

	Для Каждого Повторяющееся Из Повторяющиеся Цикл
		Задания.Добавить(Повторяющееся);
	КонецЦикла;

	ПроверитьЗадания(Задания);

	Для Каждого Повторяющееся Из Повторяющиеся Цикл
		Ожидаем.Что(Повторяющееся.Результат, "Задание не выполнило ни одного повтора").Больше(0);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЗадания(Задания)

	Ошибки = Новый Массив;

	Для Каждого Задание Из Задания Цикл

		Если Не Задание.ОжидатьЗавершения(ТаймаутЗадания()) Тогда
			Ошибки.Добавить("Задание не завершилось за отведённое время");
		ИначеЕсли Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Ошибки.Добавить(Задание.ИнформацияОбОшибке.Описание);
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Ошибки, Символы.ПС), "Задания завершились с ошибками").Равно("");

КонецПроцедуры

Процедура СброситьОстановку()

	БлокировкаОстановки = Новый БлокировкаРесурса;
	НужноОстановиться = Ложь;

КонецПроцедуры

Функция Остановлено()

	БлокировкаОстановки.Заблокировать();
	Результат = НужноОстановиться;
	БлокировкаОстановки.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура Остановить()

	БлокировкаОстановки.Заблокировать();
	НужноОстановиться = Истина;
	БлокировкаОстановки.Разблокировать();

КонецПроцедуры

Функция ПрефиксТипов()
	Возврат "ТипИзЗадания" + СтрЗаменить(Новый УникальныйИдентификатор(), "-", "_");
КонецФункции

Функция ИмяТипа(Префикс, Номер)
	Возврат СтрШаблон("%1_%2", Префикс, Формат(Номер, "ЧН=0;ЧГ=0"));
КонецФункции

Функция ПовторовСоздания()
	Возврат 20;
КонецФункции

Функция ТаймаутЗадания()
	Возврат 120000;
КонецФункции
