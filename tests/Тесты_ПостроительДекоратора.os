КонецПроцедуры

&Тест
Процедура КлассСПубличнымКонструкторомДекорируется() Экспорт

	// Построить вызывается напрямую: через Ожидаем.Метод() рефлектор не может
	// вызвать метод с параметром по умолчанию и падает независимо от построителя
	ТекстОшибки = ОшибкаПостроения(Новый ПостроительДекоратора(Новый МойКлассСПубличнымКонструктором));

	Ожидаем.Что(ТекстОшибки, "Построение не должно выбрасывать исключение").Равно("");

КонецПроцедуры

&Тест
Процедура НеопределеноИзМетодаБезИсходногоОбъектаНеПодменяется() Экспорт

	// Подмена возвращаемого значения на декоратор предназначена для сохранения
	// цепочек вызовов и не должна срабатывать, когда исходного объекта нет,
	// а метод вернул Неопределено

	Метод = Новый Метод("ВернутьЗначение")
		.Публичный()
		.Параметр(Новый ПараметрМетода("Значение"))
		.ТелоМетода("Возврат Значение;");

	Декоратор = Новый ПостроительДекоратора()
		.Метод(Метод)
		.Построить();

	Ожидаем.Что(Декоратор.ВернутьЗначение(Неопределено)).ЭтоНеопределено();
	Ожидаем.Что(Декоратор.ВернутьЗначение(1)).Равно(1);

КонецПроцедуры

&Тест
Процедура ПереименованныйМетодДелегируетсяПодИсходнымИменем() Экспорт

	// Дано

	// Объявить метод с именем "Найти" нельзя, поэтому в декораторе он получает
	// имя "_Найти". У исходного объекта метод при этом называется "Найти"
	Массив = Новый Массив;
	Массив.Добавить("а");
	Массив.Добавить("б");

	// Когда

	Декоратор = Новый ПостроительДекоратора(Массив).Построить();

	// Тогда

	Ожидаем.Что(Декоратор._Найти("б")).Равно(1);

	// И после объединения слоёв делегирование ведёт к исходному объекту
	ВнешнийДекоратор = Новый ПостроительДекоратора(Декоратор).Построить();

	Ожидаем.Что(ВнешнийДекоратор._Найти("б")).Равно(1);

КонецПроцедуры

&Тест
Процедура СлоиДекораторовОбъединяются() Экспорт

	// Дано

	МойКласс = Новый МойКласс;

	ВнутреннийДекоратор = Новый ПостроительДекоратора(МойКласс).Построить();

	// Когда

	ВнешнийДекоратор = Новый ПостроительДекоратора(ВнутреннийДекоратор).Построить();

	// Тогда

	Рефлектор = Новый Рефлектор();

	Ожидаем.Что(
		Рефлектор.ПолучитьСвойство(ВнешнийДекоратор, Константы_Декоратор.Поле_ИнстансОбъекта),
		"Внешний декоратор должен ссылаться на исходный объект, а не на внутренний декоратор"
	).Равно(МойКласс);

КонецПроцедуры

&Тест
Процедура ИзмененияВложенногоДекоратораПереносятся() Экспорт

	// Дано

	МойКласс = Новый МойКласс;
	МойКласс.Поле = 10;

	ВнутреннийДекоратор = Новый ПостроительДекоратора(МойКласс)
		.Поле(Новый Поле("СчетчикВызовов").Публичное().ЗначениеПоУмолчанию(0))
		.Перехватчик(
			Новый Перехватчик("ИзменитьЗначениеПоля")
				.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
				.Тело("СчетчикВызовов = СчетчикВызовов + 1;")
		)
		.Построить();

	// Когда

	ВнешнийДекоратор = Новый ПостроительДекоратора(ВнутреннийДекоратор)
		.Метод(Новый Метод("Удвоить").Публичный().ТелоМетода("Возврат Поле * 2;"))
		.Построить();

	ВнешнийДекоратор.ИзменитьЗначениеПоля(21);

	// Тогда

	Ожидаем.Что(ВнешнийДекоратор.СчетчикВызовов, "Перехватчик внутреннего слоя").Равно(1);
	Ожидаем.Что(ВнешнийДекоратор.Поле).Равно(21);
	Ожидаем.Что(ВнешнийДекоратор.Удвоить()).Равно(42);
	Ожидаем.Что(МойКласс.Поле).Равно(21);

КонецПроцедуры

&Тест
Процедура ПорядокПерехватчиковСохраняется() Экспорт

	// Дано

	ИмяМетода = "ИзменитьЗначениеПоля";

	ВнутреннийДекоратор = Новый ПостроительДекоратора(Новый МойКласс)
		.Поле(Новый Поле("ПротоколВызовов").Публичное().ЗначениеПоУмолчанию(""))
		.Перехватчик(
			Новый Перехватчик(ИмяМетода)
				.ТипПерехватчика(ТипыПерехватчиковМетода.ПередСинхронизациейПолей)
				.Тело("ПротоколВызовов = ПротоколВызовов + ""Б-ПередСинхр;"";")
		)
		.Перехватчик(
			Новый Перехватчик(ИмяМетода)
				.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
				.Тело("ПротоколВызовов = ПротоколВызовов + ""Б-Перед;"";")
		)
		.Перехватчик(
			Новый Перехватчик(ИмяМетода)
				.ТипПерехватчика(ТипыПерехватчиковМетода.После)
				.Тело("ПротоколВызовов = ПротоколВызовов + ""Б-После;"";")
		)
		.Построить();

	// Когда

	ВнешнийДекоратор = Новый ПостроительДекоратора(ВнутреннийДекоратор)
		.Перехватчик(
			Новый Перехватчик(ИмяМетода)
				.ТипПерехватчика(ТипыПерехватчиковМетода.ПередСинхронизациейПолей)
				.Тело("ПротоколВызовов = ПротоколВызовов + ""В-ПередСинхр;"";")
		)
		.Перехватчик(
			Новый Перехватчик(ИмяМетода)
				.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
				.Тело("ПротоколВызовов = ПротоколВызовов + ""В-Перед;"";")
		)
		.Перехватчик(
			Новый Перехватчик(ИмяМетода)
				.ТипПерехватчика(ТипыПерехватчиковМетода.После)
				.Тело("ПротоколВызовов = ПротоколВызовов + ""В-После;"";")
		)
		.Построить();

	ВнешнийДекоратор.ИзменитьЗначениеПоля(1);

	// Тогда

	// Перехватчики "до" - от внешнего слоя к внутреннему, "после" - наоборот.
	// "Перед" внешнего слоя отрабатывает раньше синхронизации полей внутреннего,
	// как это было в цепочке вложенных декораторов.
	Ожидаем.Что(ВнешнийДекоратор.ПротоколВызовов)
		.Равно("В-ПередСинхр;В-Перед;Б-ПередСинхр;Б-Перед;Б-После;В-После;");

КонецПроцедуры

&Тест
Процедура СостояниеВложенногоДекоратораСохраняется() Экспорт

	// Дано

	ВнутреннийДекоратор = Новый ПостроительДекоратора(Новый МойКласс)
		.Поле(Новый Поле("ПолеСлоя").Публичное().ЗначениеПоУмолчанию("значение по умолчанию"))
		.Построить();

	ВнутреннийДекоратор.ПолеСлоя = "живое значение";

	// Когда

	ВнешнийДекоратор = Новый ПостроительДекоратора(ВнутреннийДекоратор).Построить();

	// Тогда

	Ожидаем.Что(ВнешнийДекоратор.ПолеСлоя).Равно("живое значение");

КонецПроцедуры

&Тест
Процедура КонфликтМетодовСлоевВыбрасываетИсключение() Экспорт

	// Дано

	ВнутреннийДекоратор = Новый ПостроительДекоратора(Новый МойКласс)
		.Метод(Новый Метод("ОбщийМетод").Публичный().ТелоМетода("Возврат 1;"))
		.Построить();

	// Когда

	Построитель = Новый ПостроительДекоратора(ВнутреннийДекоратор)
		.Метод(Новый Метод("ОбщийМетод").Публичный().ТелоМетода("Возврат 2;"));

	// Тогда

	ПроверитьОшибкуПостроения(Построитель, "ОбщийМетод");

КонецПроцедуры

