&Тест
Процедура ОбращениеКМетодуСоседнегоСлояЧерезИсходныйОбъектВыбрасываетИсключение() Экспорт

	// Дано

	ВнутреннийДекоратор = Новый ПостроительДекоратора(Новый МойКласс)
		.Метод(Новый Метод("МетодСлоя").Публичный().ТелоМетода("Возврат 1;"))
		.Построить();

	// Когда

	// До объединения слоёв Декоратор_ИсходныйОбъект указывал на внутренний декоратор,
	// у которого метод есть. После объединения он указывает на исходный объект.
	Построитель = Новый ПостроительДекоратора(ВнутреннийДекоратор)
		.Метод(
			Новый Метод("ВызватьСоседа")
				.Публичный()
				.ТелоМетода("Возврат Декоратор_ИсходныйОбъект.МетодСлоя();")
		);

	// Тогда

	ПроверитьОшибкуПостроения(Построитель, "МетодСлоя");

КонецПроцедуры

&Тест
Процедура ОбращениеКПереименованномуМетодуЧерезИсходныйОбъектВыбрасываетИсключение() Экспорт

	// Дано

	// У Массива есть метод Найти. Объявить метод с таким именем нельзя,
	// поэтому в декораторе он получает имя _Найти
	ВнутреннийДекоратор = Новый ПостроительДекоратора(Новый Массив).Построить();

	// Когда

	// _Найти есть только у декоратора, у исходного массива метод называется Найти
	Построитель = Новый ПостроительДекоратора(ВнутреннийДекоратор)
		.Метод(
			Новый Метод("ВызватьНайти")
				.Публичный()
				.ТелоМетода("Возврат Декоратор_ИсходныйОбъект._Найти(1);")
		);

	// Тогда

	ПроверитьОшибкуПостроения(Построитель, "_Найти");

КонецПроцедуры

&Тест
Процедура ОбъединениеСлоевРаботаетПриРегистрацииВСистемеТипов() Экспорт

	// Дано

	ИмяНовогоКласса = ИмяНовогоКласса();

	МойКласс = Новый МойКласс;
	МойКласс.Поле = 5;

	ВнутреннийДекоратор = Новый ПостроительДекоратора(МойКласс)
		.Поле(Новый Поле("ПолеСлоя").Публичное().ЗначениеПоУмолчанию("значение по умолчанию"))
		.Метод(Новый Метод("МетодВнутреннегоСлоя").Публичный().ТелоМетода("Возврат ""внутренний"";"))
		.Построить();

	ВнутреннийДекоратор.ПолеСлоя = "живое значение";

	// Когда

	Построитель = Новый ПостроительДекоратора(ВнутреннийДекоратор)
		.Метод(Новый Метод("МетодВнешнегоСлоя").Публичный().ТелоМетода("Возврат ""внешний"";"));

	Построитель.ЗарегистрироватьВСистемеТипов(ИмяНовогоКласса);

	Результат = Новый(ИмяНовогоКласса);

	// Тогда

	Ожидаем.Что(Результат.МетодВнутреннегоСлоя()).Равно("внутренний");
	Ожидаем.Что(Результат.МетодВнешнегоСлоя()).Равно("внешний");
	Ожидаем.Что(Результат.ПолеСлоя, "Состояние развёрнутого декоратора").Равно("живое значение");
	Ожидаем.Что(Результат.Поле).Равно(5);
	Ожидаем.Что(ОбработкаДекоратора.ИсходныйТип(Результат)).Равно(Тип("МойКласс"));

КонецПроцедуры

&Тест
Процедура ЗарегистрированныйДекораторРазворачиваетсяПоТипу() Экспорт

	// Дано

	ИмяВнутреннегоКласса = ИмяНовогоКласса();

	ВнутреннийПостроитель = Новый ПостроительДекоратора(Тип("МойКласс"))
		.Метод(Новый Метод("МетодВнутреннегоСлоя").Публичный().ТелоМетода("Возврат ""внутренний"";"));

	ВнутреннийПостроитель.ЗарегистрироватьВСистемеТипов(ИмяВнутреннегоКласса);

	// Когда

	// Построитель получает не инстанс, а зарегистрированный тип декоратора:
	// слои и описание исходного объекта берутся из реестра типов
	ВнешнийДекоратор = Новый ПостроительДекоратора(Тип(ИмяВнутреннегоКласса))
		.Метод(Новый Метод("МетодВнешнегоСлоя").Публичный().ТелоМетода("Возврат ""внешний"";"))
		.Построить();

	// Тогда

	Ожидаем.Что(ВнешнийДекоратор.МетодВнутреннегоСлоя()).Равно("внутренний");
	Ожидаем.Что(ВнешнийДекоратор.МетодВнешнегоСлоя()).Равно("внешний");
	Ожидаем.Что(ОбработкаДекоратора.ИсходныйТип(ВнешнийДекоратор)).Равно(Тип("МойКласс"));

	Рефлектор = Новый Рефлектор();

	Ожидаем.Что(
		ТипЗнч(Рефлектор.ПолучитьСвойство(ВнешнийДекоратор, Константы_Декоратор.Поле_ИнстансОбъекта)),
		"Цепочка вызовов должна остаться одноуровневой"
	).Равно(Тип("МойКласс"));

КонецПроцедуры

&Тест
Процедура ПовторноеПостроениеНеНакапливаетСлои() Экспорт

	// Дано

	ВнутреннийДекоратор = Новый ПостроительДекоратора(Новый МойКласс)
		.Поле(Новый Поле("ПолеСлоя").Публичное().ЗначениеПоУмолчанию(1))
		.Построить();

	Построитель = Новый ПостроительДекоратора(ВнутреннийДекоратор);

	// Когда

	Построитель.Построить();
	ВтороеПостроение = Построитель.Построить();

	// Тогда

	Рефлектор = Новый Рефлектор();

	Ожидаем.Что(
		Рефлектор.ПолучитьСвойство(ВтороеПостроение, Константы_Декоратор.Поле_Рецепт).Количество(),
		"Слои построенного декоратора"
	).Равно(2);

	Ожидаем.Что(
		Рефлектор.ПолучитьСвойство(ВнутреннийДекоратор, Константы_Декоратор.Поле_Рецепт).Количество(),
		"Рецепт развёрнутого декоратора не должен меняться"
	).Равно(1);

	Ожидаем.Что(ВтороеПостроение.ПолеСлоя).Равно(1);

КонецПроцедуры

&Тест
Процедура ОбъединениеТрехСлоев() Экспорт

	// Дано

	МойКласс = Новый МойКласс;

	ПервыйСлой = Новый ПостроительДекоратора(МойКласс)
		.Метод(Новый Метод("МетодПервогоСлоя").Публичный().ТелоМетода("Возврат 1;"))
		.Построить();

	ВторойСлой = Новый ПостроительДекоратора(ПервыйСлой)
		.Метод(Новый Метод("МетодВторогоСлоя").Публичный().ТелоМетода("Возврат 2;"))
		.Построить();

	// Когда

	ТретийСлой = Новый ПостроительДекоратора(ВторойСлой)
		.Метод(Новый Метод("МетодТретьегоСлоя").Публичный().ТелоМетода("Возврат 3;"))
		.Построить();

	// Тогда

	Ожидаем.Что(ТретийСлой.МетодПервогоСлоя()).Равно(1);
	Ожидаем.Что(ТретийСлой.МетодВторогоСлоя()).Равно(2);
	Ожидаем.Что(ТретийСлой.МетодТретьегоСлоя()).Равно(3);

	Рефлектор = Новый Рефлектор();

	Ожидаем.Что(
		Рефлектор.ПолучитьСвойство(ТретийСлой, Константы_Декоратор.Поле_ИнстансОбъекта),
		"Цепочка вызовов должна остаться одноуровневой"
	).Равно(МойКласс);

КонецПроцедуры

&Тест
Процедура ОбъединениеСлоевОтключаетсяФлагом() Экспорт

	// Дано

	МойКласс = Новый МойКласс;

	ВнутреннийДекоратор = Новый ПостроительДекоратора(МойКласс)
		.ОбъединятьСлои(Ложь)
		.Поле(Новый Поле("ПолеСлоя").Публичное().ЗначениеПоУмолчанию("значение"))
		.Построить();

	// Когда

	ВнешнийДекоратор = Новый ПостроительДекоратора(ВнутреннийДекоратор).Построить();

	// Тогда

	Рефлектор = Новый Рефлектор();

	Ожидаем.Что(
		Рефлектор.ПолучитьСвойство(ВнешнийДекоратор, Константы_Декоратор.Поле_ИнстансОбъекта),
		"Декоратор без рецепта разворачивать нечем, он должен остаться вложенным"
	).Равно(ВнутреннийДекоратор);

	Ожидаем.Что(ВнешнийДекоратор.ПолеСлоя).Равно("значение");
	Ожидаем.Что(ОбработкаДекоратора.ИсходныйТип(ВнешнийДекоратор)).Равно(Тип("МойКласс"));

КонецПроцедуры

Функция ИмяНовогоКласса()
	Возврат "МойНовыйКласс" + СтрЗаменить(Новый УникальныйИдентификатор(), "-", "_");
КонецФункции

// Построить вызывается напрямую, а не через Ожидаем.Метод(): рефлектор не умеет
// вызывать Построить с параметром по умолчанию и выбрасывает исключение всегда,
// из-за чего проверка была бы истинной при любом поведении построителя.
//
// Параметры:
//   Построитель - ПостроительДекоратора - Построитель, который должен упасть
//   ОжидаемыйФрагмент - Строка - Фрагмент, который должен быть в тексте ошибки
//
Процедура ПроверитьОшибкуПостроения(Построитель, ОжидаемыйФрагмент)

	ТекстОшибки = ОшибкаПостроения(Построитель);

	Ожидаем.Что(ЗначениеЗаполнено(ТекстОшибки), "Построение должно было выбросить исключение").ЭтоИстина();

	Ожидаем.Что(
		СтрНайти(ТекстОшибки, ОжидаемыйФрагмент) > 0,
		СтрШаблон("В тексте ошибки нет фрагмента ""%1"". Текст: %2", ОжидаемыйФрагмент, ТекстОшибки)
	).ЭтоИстина();

КонецПроцедуры

Функция ОшибкаПостроения(Построитель)

	Попытка
		Построитель.Построить();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	Возврат "";

КонецФункции
