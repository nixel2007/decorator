#Использовать reflector

// Модель слоя изменений декоратора и операции слияния слоёв.
//
// Слой изменений - см. НовыйСлой
//
// Рецепт декоратора - Массив из см. НовыйСлой, от внутреннего слоя к внешнему.
// Он хранится в самом построенном декораторе, в служебном поле
// Константы_Декоратор.Поле_Рецепт, и позволяет следующему построителю
// собрать декоратор сразу над исходным объектом, а не над декоратором.

#Область ОписаниеПеременных

Перем Рефлектор;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Создаёт слой изменений. Коллекции копируются, поэтому дальнейшие изменения
// построителя в уже созданный слой не попадают.
//
// Параметры:
//   Поля              - Массив из Поле - Поля слоя
//   Методы            - Массив из Метод - Методы слоя
//   Перехватчики      - Массив из Перехватчик - Перехватчики слоя
//   Импорты           - Массив из Импорт - Импорты слоя
//   ШагиИнициализации - Массив из ШагИнициализации - Шаги инициализации слоя
//
//  Возвращаемое значение:
//   Структура - Слой изменений:
//     * Поля              - Массив из Поле - Поля слоя
//     * Методы            - Массив из Метод - Методы слоя
//     * Перехватчики      - Массив из Перехватчик - Перехватчики слоя
//     * Импорты           - Массив из Импорт - Импорты слоя
//     * ШагиИнициализации - Массив из ШагИнициализации - Шаги инициализации слоя
//
Функция НовыйСлой(Поля, Методы, Перехватчики, Импорты, ШагиИнициализации) Экспорт

	Возврат Новый Структура(
		"Поля, Методы, Перехватчики, Импорты, ШагиИнициализации",
		КопияМассива(Поля),
		КопияМассива(Методы),
		КопияМассива(Перехватчики),
		КопияМассива(Импорты),
		КопияМассива(ШагиИнициализации)
	);

КонецФункции

// Возвращает копию рецепта объекта.
//
// Параметры:
//   Объект - Произвольный - Объект, у которого нужно получить рецепт
//
//  Возвращаемое значение:
//   - Массив из см. НовыйСлой - от внутреннего слоя к внешнему
//   - Неопределено - объект не является декоратором либо построен без рецепта
//
Функция СлоиОбъекта(Объект) Экспорт

	Если Не ОбработкаДекоратора.ЭтоДекоратор(Объект) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Рецепт = Рефлектор.ПолучитьСвойство(Объект, Константы_Декоратор.Поле_Рецепт);
	Исключение
		// Декоратор собран из пользовательского текста сценария без служебного поля
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Рецепт) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат КопияМассива(Рецепт);

КонецФункции

// Объединяет поля слоёв.
//
// Параметры:
//   Слои - Массив из см. НовыйСлой - от внутреннего слоя к внешнему
//
//  Возвращаемое значение:
//   Массив из Поле - Поля всех слоёв
//
Функция ОбъединитьПоля(Слои) Экспорт

	Результат = Новый Массив;

	Для Каждого Слой Из Слои Цикл
		ДобавитьВсе(Результат, Слой.Поля);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Объединяет методы слоёв.
//
// Параметры:
//   Слои - Массив из см. НовыйСлой - от внутреннего слоя к внешнему
//
//  Возвращаемое значение:
//   Массив из Метод - Методы всех слоёв
//
Функция ОбъединитьМетоды(Слои) Экспорт

	Результат = Новый Массив;

	Для Каждого Слой Из Слои Цикл
		ДобавитьВсе(Результат, Слой.Методы);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Объединяет шаги инициализации слоёв.
//
// Параметры:
//   Слои - Массив из см. НовыйСлой - от внутреннего слоя к внешнему
//
//  Возвращаемое значение:
//   Массив из ШагИнициализации - Шаги инициализации всех слоёв
//
Функция ОбъединитьШагиИнициализации(Слои) Экспорт

	Результат = Новый Массив;

	Для Каждого Слой Из Слои Цикл
		ДобавитьВсе(Результат, Слой.ШагиИнициализации);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Объединяет импорты слоёв, отбрасывая повторы.
// Импорт сравнивается по своему строковому представлению: у класса Импорт нет
// доступа к имени библиотеки и типу подключения по отдельности, а Описание()
// однозначно определяется этой парой.
//
// Параметры:
//   Слои - Массив из см. НовыйСлой - от внутреннего слоя к внешнему
//
//  Возвращаемое значение:
//   Массив из Импорт - Импорты всех слоёв без повторов
//
Функция ОбъединитьИмпорты(Слои) Экспорт

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;

	Для Каждого Слой Из Слои Цикл

		Для Каждого Импорт Из Слой.Импорты Цикл

			Описание = Импорт.Описание();

			Если Добавленные.Получить(Описание) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Добавленные.Вставить(Описание, Истина);
			Результат.Добавить(Импорт);

		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Раскладывает тела перехватчиков всех слоёв по методам и типам. Собирается один раз
// на построение: иначе перехватчики перебирались бы заново для каждого метода объекта.
//
// Параметры:
//   Слои - Массив из см. НовыйСлой - от внутреннего слоя к внешнему
//
//  Возвращаемое значение:
//   Соответствие - Ключ: имя перехватываемого метода, значение: Массив по слоям, от внутреннего
//                  к внешнему. Элемент - Соответствие (ключ: ТипыПерехватчиковМетода, значение:
//                  Массив из Строка), либо Неопределено, если у слоя нет перехватчиков метода
//
Функция ИндексПерехватчиков(Слои) Экспорт

	Индекс = Новый Соответствие;

	Для НомерСлоя = 0 По Слои.ВГраница() Цикл

		Для Каждого Перехватчик Из Слои[НомерСлоя].Перехватчики Цикл

			Описание = Перехватчик.Описание();

			ПерехватчикиМетода = Индекс.Получить(Описание.ИмяМетода);

			Если ПерехватчикиМетода = Неопределено Тогда
				ПерехватчикиМетода = Новый Массив(Слои.Количество());
				Индекс.Вставить(Описание.ИмяМетода, ПерехватчикиМетода);
			КонецЕсли;

			ТелаСлоя = ПерехватчикиМетода[НомерСлоя];

			Если ТелаСлоя = Неопределено Тогда
				ТелаСлоя = Новый Соответствие;
				ПерехватчикиМетода[НомерСлоя] = ТелаСлоя;
			КонецЕсли;

			ТелаТипа = ТелаСлоя.Получить(Описание.ТипПерехватчика);

			Если ТелаТипа = Неопределено Тогда
				ТелаТипа = Новый Массив;
				ТелаСлоя.Вставить(Описание.ТипПерехватчика, ТелаТипа);
			КонецЕсли;

			ТелаТипа.Добавить(Описание.ТелоПерехватчика);

		КонецЦикла;

	КонецЦикла;

	Возврат Индекс;

КонецФункции

// Собирает тела перехватчиков метода в звенья цепочки вызова.
//
// Перехватчик "Вместо" заменяет вызов всего, что находится внутри него: перехватчиков
// внутренних слоёв и самого метода. Поэтому он завершает звено, а всё внутреннее
// уходит в следующее звено - отдельную функцию, которую перехватчик при желании
// вызывает через Декоратор_ПродолжитьВызов(). Так объединённые слои ведут себя
// как вложенные декораторы: если внешний слой не продолжил вызов, перехватчики
// внутренних слоёв не выполняются. Без перехватчиков "Вместо" звено одно.
//
// Внутри звена перехватчики "до" идут от внешнего слоя к внутреннему, "после" - наоборот.
// У всех слоёв, кроме самого внутреннего, перехватчики "Перед" переезжают
// в слот "ПередСинхронизациейПолей": в цепочке вложенных декораторов они
// отрабатывали раньше синхронизации полей внутреннего слоя, а после
// объединения от всех синхронизаций осталась только она - в звене самого
// внутреннего слоя.
//
// Параметры:
//   ИндексПерехватчиков - Соответствие - см. ИндексПерехватчиков
//   ИмяМетода - Строка - Имя метода, для которого собираются перехватчики
//
//  Возвращаемое значение:
//   Массив из Структура - Звенья от внешнего к внутреннему:
//     * Тела - Соответствие - Ключ: ТипыПерехватчиковМетода, значение: Массив из Строка
//     * Вместо - Строка - Тело перехватчика "Вместо", которое завершает звено
//              - Неопределено - Звено последнее и вызывает сам метод
//     * СинхронизацияПолей - Булево - Звено синхронизирует поля с исходным объектом
//
Функция ЗвеньяПерехватчиков(ИндексПерехватчиков, ИмяМетода) Экспорт

	Звено  = НовоеЗвено();
	Звенья = Новый Массив;
	Звенья.Добавить(Звено);

	ПерехватчикиМетода = ИндексПерехватчиков.Получить(ИмяМетода);

	Если ПерехватчикиМетода = Неопределено Тогда
		Звено.СинхронизацияПолей = Истина;
		Возврат Звенья;
	КонецЕсли;

	ВнешнийСлой = ПерехватчикиМетода.ВГраница();

	// Слои обходятся снаружи внутрь
	Для Смещение = 0 По ВнешнийСлой Цикл

		НомерСлоя = ВнешнийСлой - Смещение;
		ЭтоВнутреннийСлой = (НомерСлоя = 0);

		Если ЭтоВнутреннийСлой Тогда
			Звено.СинхронизацияПолей = Истина;
		КонецЕсли;

		ТелаСлоя = ПерехватчикиМетода[НомерСлоя];

		Если ТелаСлоя = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьТела(Звено, ТелаСлоя, ТипыПерехватчиковМетода.ПередСинхронизациейПолей);

		Если ЭтоВнутреннийСлой Тогда
			ДобавитьТела(Звено, ТелаСлоя, ТипыПерехватчиковМетода.Перед);
		Иначе
			ДобавитьТела(Звено, ТелаСлоя, ТипыПерехватчиковМетода.Перед, ТипыПерехватчиковМетода.ПередСинхронизациейПолей);
		КонецЕсли;

		// "После" внутреннего слоя отрабатывают раньше
		ДобавитьТелаВНачало(Звено, ТелаСлоя, ТипыПерехватчиковМетода.ПослеВызоваИсключения);
		ДобавитьТелаВНачало(Звено, ТелаСлоя, ТипыПерехватчиковМетода.После);

		ТелаВместо = ТелаСлоя.Получить(ТипыПерехватчиковМетода.Вместо);

		Если ТелаВместо = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ТелоВместо Из ТелаВместо Цикл
			Звено.Вместо = ТелоВместо;
			Звено = НовоеЗвено();
			Звенья.Добавить(Звено);
		КонецЦикла;

	КонецЦикла;

	Возврат Звенья;

КонецФункции

// Проверяет, что имена полей и методов слоёв не конфликтуют между собой,
// с исходным объектом и со служебными полями декоратора.
// Все эти случаи привели бы к повторному объявлению в одном модуле,
// то есть к ошибке компиляции сгенерированного сценария.
//
// Параметры:
//   Слои - Массив из см. НовыйСлой - от внутреннего слоя к внешнему
//   ИменаПолейИсходногоОбъекта - Массив из Строка - Имена полей исходного объекта
//   ИменаМетодовИсходногоОбъекта - Массив из Строка - Имена методов исходного объекта
//
Процедура ПроверитьКонфликты(Слои, ИменаПолейИсходногоОбъекта, ИменаМетодовИсходногоОбъекта) Экспорт

	ЗанятыеПоля   = Новый Соответствие;
	ЗанятыеМетоды = Новый Соответствие;

	Для Каждого ИмяСлужебногоПоля Из Константы_Декоратор.ИменаСлужебныхПолей Цикл
		ЗанятыеПоля.Вставить(НРег(ИмяСлужебногоПоля), "служебное поле декоратора");
		ЗанятыеМетоды.Вставить(НРег(ИмяСлужебногоПоля), "служебное поле декоратора");
	КонецЦикла;

	Для Каждого ИмяПоля Из ИменаПолейИсходногоОбъекта Цикл
		ЗанятыеПоля.Вставить(НРег(ИмяПоля), "поле исходного объекта");
	КонецЦикла;

	Для Каждого ИмяМетода Из ИменаМетодовИсходногоОбъекта Цикл
		ЗанятыеМетоды.Вставить(НРег(ИмяМетода), "метод исходного объекта");
		ЗанятыеМетоды.Вставить(НРег(ВнутреннееИмяМетода(ИмяМетода)), "метод исходного объекта");
	КонецЦикла;

	НомерСлоя = 0;

	Для Каждого Слой Из Слои Цикл

		НомерСлоя = НомерСлоя + 1;
		ОписаниеСлоя = СтрШаблон("слой %1", НомерСлоя);

		Для Каждого Поле Из Слой.Поля Цикл
			ЗанятьИмя(ЗанятыеПоля, Поле.ИмяПоля(), "Поле", ОписаниеСлоя);
		КонецЦикла;

		Для Каждого Метод Из Слой.Методы Цикл
			ЗанятьИмя(ЗанятыеМетоды, Метод.ИмяМетода(), "Метод", ОписаниеСлоя);
			ЗанятьИмя(ЗанятыеМетоды, ВнутреннееИмяМетода(Метод.ИмяМетода()), "Метод", ОписаниеСлоя);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Проверяет, что тела слоёв не обращаются через служебное поле исходного объекта
// к методам, которых у исходного объекта нет.
//
// До объединения слоёв это поле указывало на соседний декоратор, у которого такие
// методы были. После объединения оно указывает на исходный объект, поэтому такое
// обращение сломалось бы в рантайме.
//
// Параметры:
//   Слои - Массив из см. НовыйСлой - от внутреннего слоя к внешнему
//   НедоступныеИмена - Массив из Строка - Имена методов, которых нет у исходного объекта
//
Процедура ПроверитьОбращенияКИсходномуОбъекту(Слои, НедоступныеИмена) Экспорт

	Если НедоступныеИмена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Слой Из Слои Цикл

		Для Каждого Метод Из Слой.Методы Цикл
			ПроверитьТело(Метод.ТекстТела(), НедоступныеИмена, СтрШаблон("метода ""%1""", Метод.ИмяМетода()));
		КонецЦикла;

		Для Каждого Перехватчик Из Слой.Перехватчики Цикл
			ОписаниеПерехватчика = Перехватчик.Описание();
			ПроверитьТело(
				ОписаниеПерехватчика.ТелоПерехватчика,
				НедоступныеИмена,
				СтрШаблон("перехватчика ""%1"" метода ""%2""",
					ОписаниеПерехватчика.ТипПерехватчика,
					ОписаниеПерехватчика.ИмяМетода)
			);
		КонецЦикла;

		Для Каждого ШагИнициализации Из Слой.ШагиИнициализации Цикл
			ПроверитьТело(ШагИнициализации.Описание(), НедоступныеИмена, "шага инициализации");
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Возвращает имя внутреннего метода, который генерируется рядом с публичной обёрткой.
//
// Параметры:
//   ИмяМетода - Строка - Имя публичного метода
//
//  Возвращаемое значение:
//   Строка - Имя внутреннего метода
//
Функция ВнутреннееИмяМетода(ИмяМетода) Экспорт
	Возврат "ДекораторВнутренний_" + ИмяМетода;
КонецФункции

// Возвращает имя функции звена цепочки перехватчиков метода, см. ЗвеньяПерехватчиков.
// Первое звено - сам метод, поэтому номера имён начинаются с 1.
//
// Параметры:
//   ИмяМетода - Строка - Имя публичного метода
//   НомерЗвена - Число - Номер звена, начиная с 1
//
//  Возвращаемое значение:
//   Строка - Имя функции звена
//
Функция ИмяЗвенаМетода(ИмяМетода, НомерЗвена) Экспорт
	Возврат СтрШаблон("ДекораторПродолжение%1_%2", Формат(НомерЗвена, "ЧГ=0"), ИмяМетода);
КонецФункции

// Возвращает имя метода, в который выносится тело перехватчика "Вместо", завершающего звено.
//
// Параметры:
//   ИмяМетода - Строка - Имя публичного метода
//   НомерЗвена - Число - Номер звена, которое завершает перехватчик, начиная с 0
//
//  Возвращаемое значение:
//   Строка - Имя метода перехватчика
//
Функция ИмяМетодаВместо(ИмяМетода, НомерЗвена) Экспорт
	Возврат СтрШаблон("ДекораторВместо%1_%2", Формат(НомерЗвена + 1, "ЧГ=0"), ИмяМетода);
КонецФункции

// Заменяет в коде вызовы метода без параметров на выражение.
//
// Вызов ищется так, как его понимает язык: без учёта регистра, с любыми пробелами
// между именем и скобками. Строковые литералы и комментарии не просматриваются.
// Имя должно стоять отдельно: не как часть более длинного имени и не как метод
// другого объекта после точки.
//
// Параметры:
//   Текст - Строка - Текст кода
//   ИмяМетода - Строка - Имя заменяемого метода
//   Выражение - Строка - Текст, которым заменяется вызов вместе со скобками
//
//  Возвращаемое значение:
//   Структура - Результат замены:
//     * Текст - Строка - Текст с заменёнными вызовами
//     * КоличествоВызовов - Число - Количество заменённых вызовов
//
Функция ЗаменитьВызовыМетода(Текст, ИмяМетода, Выражение) Экспорт

	Результат = Новый Структура("Текст, КоличествоВызовов", Текст, 0);

	// Имени в тексте нет - и разбирать нечего
	Если СтрНайти(НРег(Текст), НРег(ИмяМетода)) = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Части = Новый Массив;

	Для Каждого Фрагмент Из ФрагментыТекста(Текст) Цикл

		Если Фрагмент.Вид = ВидФрагментаКод() Тогда
			Части.Добавить(ЗаменитьВызовыВКоде(Фрагмент.Текст, ИмяМетода, Выражение, Результат));
		Иначе
			Части.Добавить(Фрагмент.Текст);
		КонецЕсли;

	КонецЦикла;

	Результат.Текст = СтрСоединить(Части, "");

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КопияМассива(Массив)

	Результат = Новый Массив;

	Если Массив = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ДобавитьВсе(Результат, Массив);

	Возврат Результат;

КонецФункции

Процедура ДобавитьВсе(Приёмник, Источник)

	Для Каждого Элемент Из Источник Цикл
		Приёмник.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

// Добавляет в слот звена тела перехватчиков слоя одного типа.
//
// Параметры:
//   Звено - Структура - Звено, см. ЗвеньяПерехватчиков
//   ТелаСлоя - Соответствие - Тела перехватчиков слоя по типам, см. ИндексПерехватчиков
//   ТипПерехватчика - Строка - Тип добавляемых перехватчиков, см. ТипыПерехватчиковМетода
//   ТипСлота - Строка - Слот звена, в который добавляются тела. По умолчанию - слот того же типа
//
Процедура ДобавитьТела(Звено, ТелаСлоя, ТипПерехватчика, ТипСлота = Неопределено)

	Тела = ТелаСлоя.Получить(ТипПерехватчика);

	Если Тела = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДобавитьВсе(Звено.Тела.Получить(?(ТипСлота = Неопределено, ТипПерехватчика, ТипСлота)), Тела);

КонецПроцедуры

Процедура ДобавитьТелаВНачало(Звено, ТелаСлоя, ТипПерехватчика)

	Тела = ТелаСлоя.Получить(ТипПерехватчика);

	Если Тела = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Слот = Звено.Тела.Получить(ТипПерехватчика);

	Для Индекс = 0 По Тела.ВГраница() Цикл
		Слот.Вставить(Индекс, Тела[Индекс]);
	КонецЦикла;

КонецПроцедуры

Функция НовоеЗвено()

	Тела = Новый Соответствие;

	Тела.Вставить(ТипыПерехватчиковМетода.Перед, Новый Массив);
	Тела.Вставить(ТипыПерехватчиковМетода.После, Новый Массив);
	Тела.Вставить(ТипыПерехватчиковМетода.ПослеВызоваИсключения,    Новый Массив);
	Тела.Вставить(ТипыПерехватчиковМетода.ПередСинхронизациейПолей, Новый Массив);

	Возврат Новый Структура("Тела, Вместо, СинхронизацияПолей", Тела, Неопределено, Ложь);

КонецФункции

Процедура ЗанятьИмя(ЗанятыеИмена, Имя, ВидОбъекта, ОписаниеСлоя)

	Ключ = НРег(Имя);

	ПредыдущийВладелец = ЗанятыеИмена.Получить(Ключ);

	Если ПредыдущийВладелец <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"%1 ""%2"" из слоя ""%3"" конфликтует с именем, которое уже занимает %4."
			+ " Одноимённые объявления в одном модуле декоратора невозможны.",
			ВидОбъекта,
			Имя,
			ОписаниеСлоя,
			ПредыдущийВладелец
		);
	КонецЕсли;

	ЗанятыеИмена.Вставить(Ключ, СтрШаблон("%1 из слоя ""%2""", ВидОбъекта, ОписаниеСлоя));

КонецПроцедуры

Процедура ПроверитьТело(Тело, НедоступныеИмена, ОписаниеВладельца)

	Если Не ЗначениеЗаполнено(Тело) Тогда
		Возврат;
	КонецЕсли;

	ТелоВНижнемРегистре = НРег(ТолькоКод(Тело));

	Для Каждого НедоступноеИмя Из НедоступныеИмена Цикл

		ИскомыйТекст = НРег(Константы_Декоратор.Поле_ИнстансОбъекта + "." + НедоступноеИмя);

		Если Не ЕстьОбращение(ТелоВНижнемРегистре, ИскомыйТекст) Тогда
			Продолжить;
		КонецЕсли;

		ВызватьИсключение СтрШаблон(
			"Тело %1 обращается к ""%2.%3"", но после объединения слоёв это поле указывает"
			+ " на исходный объект, у которого метода ""%3"" нет."
			+ " Используйте ""ЭтотОбъект.%3"".",
			ОписаниеВладельца,
			Константы_Декоратор.Поле_ИнстансОбъекта,
			НедоступноеИмя
		);

	КонецЦикла;

КонецПроцедуры

// Убирает из текста комментарии и строковые литералы, чтобы упоминание обращения
// в комментарии или в строке не считалось обращением.
//
// Параметры:
//   Текст - Строка - Исходный текст
//
//  Возвращаемое значение:
//   Строка - Текст без комментариев и строковых литералов
//
Функция ТолькоКод(Текст)

	Результат = Новый Массив;

	Для Каждого Фрагмент Из ФрагментыТекста(Текст) Цикл

		Если Фрагмент.Вид = ВидФрагментаКод() Тогда
			Результат.Добавить(Фрагмент.Текст);
			Продолжить;
		КонецЕсли;

		// Литерал и комментарий отбрасываются. Переносы многострочного литерала сохраняем,
		// чтобы не склеить код до литерала с кодом после него; в комментарии переносов нет.
		КоличествоПереносов = СтрЧислоВхождений(Фрагмент.Текст, Символы.ПС);

		Пока КоличествоПереносов > 0 Цикл
			Результат.Добавить(Символы.ПС);
			КоличествоПереносов = КоличествоПереносов - 1;
		КонецЦикла;

	КонецЦикла;

	Возврат СтрСоединить(Результат, "");

КонецФункции

// Делит текст на фрагменты кода, строковых литералов и комментариев.
// Литерал включает обе кавычки, комментарий - всё от "//" до конца строки.
//
// Параметры:
//   Текст - Строка - Исходный текст
//
//  Возвращаемое значение:
//   Массив из Структура - Фрагменты по порядку, склеенные дают исходный текст:
//     * Вид - Строка - См. ВидФрагментаКод, ВидФрагментаЛитерал, ВидФрагментаКомментарий
//     * Текст - Строка - Текст фрагмента
//
Функция ФрагментыТекста(Текст)

	Фрагменты = Новый Массив;

	Вид     = ВидФрагментаКод();
	Начало  = 1;
	Позиция = 1;

	// Текст не перебирается посимвольно: от границы к границе фрагментов - поиском
	Пока Позиция <= СтрДлина(Текст) Цикл

		Если Вид = ВидФрагментаКод() Тогда
			Граница = ГраницаКода(Текст, Позиция);
		ИначеЕсли Вид = ВидФрагментаЛитерал() Тогда
			Граница = ГраницаЛитерала(Текст, Позиция);
		Иначе
			Граница = ГраницаКомментария(Текст, Позиция);
		КонецЕсли;

		Если Граница = Неопределено Тогда
			Прервать;
		КонецЕсли;

		ДобавитьФрагмент(Фрагменты, Вид, Текст, Начало, Граница.Конец);

		Вид     = Граница.Вид;
		Начало  = Граница.Конец + 1;
		Позиция = Граница.Позиция;

	КонецЦикла;

	ДобавитьФрагмент(Фрагменты, Вид, Текст, Начало, СтрДлина(Текст));

	Возврат Фрагменты;

КонецФункции

// Код заканчивается перед ближайшей кавычкой или "//".
//
// Параметры:
//   Текст - Строка - Исходный текст
//   Позиция - Число - Позиция, с которой ищется граница
//
//  Возвращаемое значение:
//   - Структура - см. НоваяГраница
//   - Неопределено - код тянется до конца текста
//
Функция ГраницаКода(Текст, Позиция)

	Кавычка     = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, Позиция);
	Комментарий = СтрНайти(Текст, "//", НаправлениеПоиска.СНачала, Позиция);

	Если Кавычка = 0 И Комментарий = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Комментарий = 0 Или (Кавычка <> 0 И Кавычка < Комментарий) Тогда
		Возврат НоваяГраница(Кавычка - 1, ВидФрагментаЛитерал(), Кавычка + 1);
	КонецЕсли;

	Возврат НоваяГраница(Комментарий - 1, ВидФрагментаКомментарий(), Комментарий + СтрДлина("//"));

КонецФункции

// Литерал заканчивается закрывающей кавычкой и включает её. Удвоенная кавычка -
// экранированная кавычка внутри литерала.
//
// Параметры:
//   Текст - Строка - Исходный текст
//   Позиция - Число - Позиция после открывающей кавычки
//
//  Возвращаемое значение:
//   - Структура - см. НоваяГраница
//   - Неопределено - литерал не закрыт до конца текста
//
Функция ГраницаЛитерала(Текст, Знач Позиция)

	Пока Позиция <= СтрДлина(Текст) Цикл

		Кавычка = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, Позиция);

		Если Кавычка = 0 Тогда
			Прервать;
		КонецЕсли;

		Если Сред(Текст, Кавычка + 1, 1) <> """" Тогда
			Возврат НоваяГраница(Кавычка, ВидФрагментаКод(), Кавычка + 1);
		КонецЕсли;

		Позиция = Кавычка + СтрДлина("""""");

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Комментарий тянется до конца строки. Перенос строки после него - уже код.
//
// Параметры:
//   Текст - Строка - Исходный текст
//   Позиция - Число - Позиция после "//"
//
//  Возвращаемое значение:
//   - Структура - см. НоваяГраница
//   - Неопределено - комментарий тянется до конца текста
//
Функция ГраницаКомментария(Текст, Позиция)

	Перенос = СтрНайти(Текст, Символы.ПС, НаправлениеПоиска.СНачала, Позиция);

	Если Перенос = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НоваяГраница(Перенос - 1, ВидФрагментаКод(), Перенос);

КонецФункции

// Граница фрагмента текста.
//
// Параметры:
//   Конец - Число - Позиция последнего символа фрагмента
//   Вид - Строка - Вид следующего фрагмента
//   Позиция - Число - Позиция, с которой ищется граница следующего фрагмента
//
//  Возвращаемое значение:
//   Структура - Граница с одноимёнными полями
//
Функция НоваяГраница(Конец, Вид, Позиция)
	Возврат Новый Структура("Конец, Вид, Позиция", Конец, Вид, Позиция);
КонецФункции

Процедура ДобавитьФрагмент(Фрагменты, Вид, Текст, Начало, Конец)

	Если Конец < Начало Тогда
		Возврат;
	КонецЕсли;

	Фрагменты.Добавить(Новый Структура("Вид, Текст", Вид, Сред(Текст, Начало, Конец - Начало + 1)));

КонецПроцедуры

Функция ВидФрагментаКод()
	Возврат "Код";
КонецФункции

Функция ВидФрагментаЛитерал()
	Возврат "Литерал";
КонецФункции

Функция ВидФрагментаКомментарий()
	Возврат "Комментарий";
КонецФункции

Функция ЗаменитьВызовыВКоде(Код, ИмяМетода, Выражение, Результат)

	Части = Новый Массив;

	КодВНижнемРегистре  = НРег(Код);
	ИмяВНижнемРегистре  = НРег(ИмяМетода);
	НачалоНеизмененного = 1;
	Позиция             = 1;

	// Вызов может стоять в самом конце кода: искать дальше конца нельзя
	Пока Позиция <= СтрДлина(Код) Цикл

		НачалоИмени = СтрНайти(КодВНижнемРегистре, ИмяВНижнемРегистре, НаправлениеПоиска.СНачала, Позиция);

		Если НачалоИмени = 0 Тогда
			Прервать;
		КонецЕсли;

		ПозицияПослеВызова = ПозицияПослеВызоваБезПараметров(Код, НачалоИмени, СтрДлина(ИмяМетода));

		Если ПозицияПослеВызова = 0 Тогда
			Позиция = НачалоИмени + 1;
			Продолжить;
		КонецЕсли;

		Части.Добавить(Сред(Код, НачалоНеизмененного, НачалоИмени - НачалоНеизмененного));
		Части.Добавить(Выражение);

		Результат.КоличествоВызовов = Результат.КоличествоВызовов + 1;

		НачалоНеизмененного = ПозицияПослеВызова;
		Позиция             = ПозицияПослеВызова;

	КонецЦикла;

	Части.Добавить(Сред(Код, НачалоНеизмененного));

	Возврат СтрСоединить(Части, "");

КонецФункции

// Проверяет, что с позиции имени начинается вызов метода без параметров: имя стоит
// отдельно - не хвост более длинного имени и не метод другого объекта после точки,
// за ним идут скобки, между ними допустимы только пробелы.
//
// Параметры:
//   Код - Строка - Текст кода
//   НачалоИмени - Число - Позиция найденного имени
//   ДлинаИмени - Число - Длина имени
//
//  Возвращаемое значение:
//   Число - Позиция после закрывающей скобки, либо 0, если это не вызов метода без параметров
//
Функция ПозицияПослеВызоваБезПараметров(Код, НачалоИмени, ДлинаИмени)

	Позиция = НачалоИмени - 1;

	Если Позиция >= 1 И ЭтоСимволИмени(Сред(Код, Позиция, 1)) Тогда
		Возврат 0;
	КонецЕсли;

	Пока Позиция >= 1 И ЭтоПробельныйСимвол(Сред(Код, Позиция, 1)) Цикл
		Позиция = Позиция - 1;
	КонецЦикла;

	Если Позиция >= 1 И Сред(Код, Позиция, 1) = "." Тогда
		Возврат 0;
	КонецЕсли;

	Позиция = НачалоИмени + ДлинаИмени;

	Если ЭтоСимволИмени(Сред(Код, Позиция, 1)) Тогда
		Возврат 0;
	КонецЕсли;

	Позиция = ПозицияПослеПробелов(Код, Позиция);

	Если Сред(Код, Позиция, 1) <> "(" Тогда
		Возврат 0;
	КонецЕсли;

	Позиция = ПозицияПослеПробелов(Код, Позиция + 1);

	Если Сред(Код, Позиция, 1) <> ")" Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Позиция + 1;

КонецФункции

Функция ПозицияПослеПробелов(Код, Позиция)

	Результат = Позиция;

	Пока ЭтоПробельныйСимвол(Сред(Код, Результат, 1)) Цикл
		Результат = Результат + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоПробельныйСимвол(Символ)
	Возврат Символ = " " Или Символ = Символы.Таб Или Символ = Символы.ПС Или Символ = Символы.ВК;
КонецФункции

Функция ЭтоСимволИмени(Символ)

	Если Символ = "" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти("abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789_", НРег(Символ)) <> 0;

КонецФункции

// Ищет обращение, за которым не продолжается более длинное имя:
// "Декоратор_ИсходныйОбъект.Тест" не должен находиться в "...Объект.ТестДругой".
// Проверяются все вхождения, а не только первое.
Функция ЕстьОбращение(Текст, ИскомыйТекст)

	НомерВхождения = 1;

	Пока Истина Цикл

		Позиция = СтрНайти(Текст, ИскомыйТекст, НаправлениеПоиска.СНачала, 1, НомерВхождения);

		Если Позиция = 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Не ЭтоЧастьБолееДлинногоИмени(Текст, Позиция + СтрДлина(ИскомыйТекст)) Тогда
			Возврат Истина;
		КонецЕсли;

		НомерВхождения = НомерВхождения + 1;

	КонецЦикла;

КонецФункции

Функция ЭтоЧастьБолееДлинногоИмени(Текст, ПозицияПослеИмени)
	Возврат ЭтоСимволИмени(Сред(Текст, ПозицияПослеИмени, 1));
КонецФункции

#КонецОбласти

// #Область Инициализация

Рефлектор = Новый Рефлектор();

// #КонецОбласти
