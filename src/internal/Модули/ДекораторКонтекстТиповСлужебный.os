Перем КешИнстансИсходногоОбъекта; // Кеш инстансов исходных объектов по именам типов
Перем КешЗначениеПоляПоУмолчанию; // Кеш значений по умолчанию для полей типов
Перем КешРецепта;                 // Кеш рецептов декораторов по именам типов
Перем КешИмениТипа;               // Имена зарегистрированных типов по значению Тип

// Возвращает описание исходного объекта зарегистрированного типа.
//
// Параметры:
//   ИмяТипа - Строка - Имя зарегистрированного типа
//
//  Возвращаемое значение:
//   - Структура - описание исходного объекта:
//     * РежимСозданияИзТипа - Булево - исходный объект задан типом
//     * ИсходныйОбъект - Произвольный, Тип - исходный объект или его тип
//     * ЗначенияПараметровКонструктораПоТипу - Массив из Произвольный - параметры конструктора
//     * ДопуститьОтсутствиеИнстанса - Булево - падение конструктора типа не прерывает построение
//   - Неопределено - тип не зарегистрирован
//
Функция ОписаниеИсходногоОбъекта(ИмяТипа) Экспорт
	Возврат КешИнстансИсходногоОбъекта.Получить(ИмяТипа);
КонецФункции

Функция ИнстансИсходногоОбъекта(ИмяТипа) Экспорт

	ОписаниеИсходногоОбъекта = КешИнстансИсходногоОбъекта.Получить(ИмяТипа);

	Если ОписаниеИсходногоОбъекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СоздатьИнстансИсходногоОбъекта(
		ОписаниеИсходногоОбъекта.РежимСозданияИзТипа,
		ОписаниеИсходногоОбъекта.ИсходныйОбъект,
		ОписаниеИсходногоОбъекта.ЗначенияПараметровКонструктораПоТипу,
		ОписаниеИсходногоОбъекта.ДопуститьОтсутствиеИнстанса
	);

КонецФункции

// Создаёт инстанс исходного объекта декоратора.
//
// Параметры:
//   РежимСозданияИзТипа - Булево - Исходный объект задан типом
//   ИсходныйОбъект - Произвольный, Тип - Исходный объект или его тип
//   ЗначенияПараметровКонструктораПоТипу - Массив из Произвольный - Параметры конструктора по типу
//   ДопуститьОтсутствиеИнстанса - Булево - Падение конструктора типа не прерывает построение
//
//  Возвращаемое значение:
//   - Произвольный - инстанс исходного объекта
//   - Неопределено - конструктор типа выбросил исключение при допустимом отсутствии инстанса
//
Функция СоздатьИнстансИсходногоОбъекта(
	Знач РежимСозданияИзТипа,
	Знач ИсходныйОбъект,
	Знач ЗначенияПараметровКонструктораПоТипу,
	Знач ДопуститьОтсутствиеИнстанса) Экспорт

	Если Не РежимСозданияИзТипа Тогда
		Возврат ИсходныйОбъект;
	КонецЕсли;

	Если Не ДопуститьОтсутствиеИнстанса Тогда
		Возврат Новый(ИсходныйОбъект, ЗначенияПараметровКонструктораПоТипу);
	КонецЕсли;

	Инстанс = Неопределено;

	Попытка
		Инстанс = Новый(ИсходныйОбъект, ЗначенияПараметровКонструктораПоТипу);
	Исключение
		// Конструктор типа недоступен - декоратор строится без инстанса
	КонецПопытки;

	Возврат Инстанс;

КонецФункции

Функция ЗначениеПоляПоУмолчанию(ИмяТипа, ИмяПоля) Экспорт
	
	КешПолейПоТипу = КешЗначениеПоляПоУмолчанию.Получить(ИмяТипа);

	Если КешПолейПоТипу = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат КешПолейПоТипу.Получить(ИмяПоля);
	КонецЕсли;

КонецФункции

Процедура УстановитьЗначениеПоляПоУмолчанию(ИмяТипа, ИмяПоля, Значение) Экспорт
	
	КешПолейПоТипу = КешЗначениеПоляПоУмолчанию.Получить(ИмяТипа);

	Если КешПолейПоТипу = Неопределено Тогда
		КешПолейПоТипу = Новый Соответствие;
		КешЗначениеПоляПоУмолчанию.Вставить(ИмяТипа, КешПолейПоТипу);
	КонецЕсли;

	КешПолейПоТипу.Вставить(ИмяПоля, Значение);

КонецПроцедуры

Процедура УстановитьИнстансИсходногоОбъекта(
	ИмяТипа,
	РежимСозданияИзТипа,
	ИсходныйОбъект,
	ЗначенияПараметровКонструктораПоТипу = Неопределено,
	ДопуститьОтсутствиеИнстанса = Ложь) Экспорт

	КешИнстансИсходногоОбъекта.Вставить(
		ИмяТипа,
		Новый Структура(
			"РежимСозданияИзТипа, ИсходныйОбъект, ЗначенияПараметровКонструктораПоТипу, ДопуститьОтсутствиеИнстанса",
			РежимСозданияИзТипа, ИсходныйОбъект, ЗначенияПараметровКонструктораПоТипу, ДопуститьОтсутствиеИнстанса
		)
	);

КонецПроцедуры

// Возвращает рецепт зарегистрированного типа.
// Читается из тела сгенерированного модуля при каждом создании инстанса,
// поэтому всегда возвращается копия: слои не должны утечь в чужой построитель.
//
// Параметры:
//   ИмяТипа - Строка - Имя зарегистрированного типа
//
//  Возвращаемое значение:
//   Массив из см. СлоиДекоратора.НовыйСлой - слои изменений от внутреннего слоя
//     к внешнему. Для незарегистрированного типа - пустой массив
//
Функция Рецепт(ИмяТипа) Экспорт

	Результат = Новый Массив;

	Слои = КешРецепта.Получить(ИмяТипа);

	Если Слои = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Слой Из Слои Цикл
		Результат.Добавить(Слой);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запоминает рецепт зарегистрированного типа.
//
// Параметры:
//   ИмяТипа - Строка - Имя, под которым тип зарегистрирован в системе типов
//   Слои - Массив из см. СлоиДекоратора.НовыйСлой - от внутреннего слоя к внешнему
//
Процедура УстановитьРецепт(ИмяТипа, Слои) Экспорт

	КешРецепта.Вставить(ИмяТипа, Слои);

КонецПроцедуры

// Запоминает соответствие значения Тип имени зарегистрированного типа.
// Соответствие со строковыми ключами регистрозависимо, а Тип() - нет,
// поэтому по значению Тип получить каноническое имя надёжнее.
//
// Параметры:
//   ИмяТипа - Строка - Имя, под которым тип зарегистрирован в системе типов
//
Процедура ЗапомнитьЗарегистрированныйТип(ИмяТипа) Экспорт

	КешИмениТипа.Вставить(Тип(ИмяТипа), ИмяТипа);

КонецПроцедуры

// Возвращает имя зарегистрированного типа декоратора.
//
// Параметры:
//   ТипДекоратора - Тип - Проверяемый тип
//
//  Возвращаемое значение:
//   - Строка - имя типа
//   - Неопределено - тип не регистрировался как декоратор
//
Функция ИмяЗарегистрированногоТипа(ТипДекоратора) Экспорт

	Возврат КешИмениТипа.Получить(ТипДекоратора);

КонецФункции

КешИнстансИсходногоОбъекта = Новый Соответствие();
КешЗначениеПоляПоУмолчанию = Новый Соответствие();
КешРецепта                 = Новый Соответствие();
КешИмениТипа               = Новый Соответствие();
