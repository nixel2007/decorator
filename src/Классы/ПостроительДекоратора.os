#Использовать logos
#Использовать tempfiles
#Использовать "../internal"

#Область ОписаниеПеременных

// Инстанс логгера
Перем Лог;

// Объект, переданный в конструктор
Перем ПереданныйОбъект;

// Ссылка на исходный объект
Перем ИсходныйОбъект;

// Ссылка на конструируемый декоратор
Перем Декоратор;

// Массив добавленных пользователем методов
Перем ПользовательскиеМетоды;

// Массив добавленных пользователем полей
Перем ПользовательскиеПоля;

// Массив добавленных пользователем импортов библиотек
Перем ПользовательскиеИмпорты;

// Массив добавленных пользователем шагов инициализации
Перем ПользовательскиеШагиИнициализации;

// Массив добавленных служебных шагов инициализации
Перем СлужебныеШагиИнициализации;

// Массив добавленных пользователем перехватчиков вызовов методов
Перем ПерехватчикиМетодов;

// Массив значения параметров инициализатора объекта по типу
Перем ЗначенияПараметровКонструктораПоТипу;

// Декоратор создаётся из типа
Перем РежимСозданияИзТипа;

// Флаг поддержки возможности отладки добавленных методов
Перем Отладка;

// Объединять слои вложенных декораторов вместо вкладывания
Перем ОбъединятьСлои;

// Слои изменений развёрнутых декораторов, от внутреннего слоя к внешнему
Перем УнаследованныеСлои;

// Развёрнутый декоратор, у которого нужно забрать живое состояние полей
Перем ОбъектВерхнегоСлоя;

// Цепочка декораторов уже развёрнута
Перем СлоиРазвернуты;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Включает возможность отладки. Достигается сохранением текста модуля во временный файл.
//
//  Возвращаемое значение:
//   ПостроительДекоратора - Ссылка на текущий инстанс ПостроительДекоратора
//
Функция Отладка(Включена = Истина) Экспорт

	Отладка = Включена;

	Возврат ЭтотОбъект;

КонецФункции

// Управляет объединением слоёв вложенных декораторов.
//
// При включённом объединении декоратор над декоратором строится сразу над
// исходным объектом, а изменения развёрнутых слоёв переносятся внутрь.
// При выключенном декоратор вкладывается, и построенный объект не оставляет
// рецепта, поэтому и следующий слой развернуть его не сможет.
//
// Параметры:
//   Включено - Булево - Объединять слои
//
//  Возвращаемое значение:
//   ПостроительДекоратора - Ссылка на текущий инстанс ПостроительДекоратора
//
Функция ОбъединятьСлои(Включено = Истина) Экспорт

	ОбъединятьСлои = Включено;

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет в декоратор новое поле
//
// Параметры:
//   Поле - Поле - Добавляемое поле
//
//  Возвращаемое значение:
//   ПостроительДекоратора - Ссылка на текущий инстанс ПостроительДекоратора
//
Функция Поле(Поле) Экспорт

	ПользовательскиеПоля.Добавить(Поле);

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет в декоратор новый метод.
//
// Параметры:
//   Метод - Метод - Добавляемый метод.
//
//  Возвращаемое значение:
//   ПостроительДекоратора - Ссылка на текущий инстанс ПостроительДекоратора
//
Функция Метод(Метод) Экспорт

	ПользовательскиеМетоды.Добавить(Метод);

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет в декоратор перехватчик
//
// Параметры:
//   Перехватчик - Перехватчик - Добавляемый перехватчик
//
//  Возвращаемое значение:
//   ПостроительДекоратора - Ссылка на текущий инстанс ПостроительДекоратора
//
Функция Перехватчик(Перехватчик) Экспорт

	ПерехватчикиМетодов.Добавить(Перехватчик);

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет в декоратор импорт библиотеки (#Использовать).
//
// Параметры:
//   Импорт - Импорт - Импорт библиотеки
//
//  Возвращаемое значение:
//   ПостроительДекоратора - Ссылка на текущий инстанс ПостроительДекоратора
//
Функция Импорт(Импорт) Экспорт

	ПользовательскиеИмпорты.Добавить(Импорт);

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет в декоратор шаг инициализации в тело модуля.
//
// Параметры:
//   ШагИнициализации - ШагИнициализации - Выполняемый шаг инициализации
//
//  Возвращаемое значение:
//   ПостроительДекоратора - Ссылка на текущий инстанс ПостроительДекоратора
//
Функция ШагИнициализации(ШагИнициализации) Экспорт

	ПользовательскиеШагиИнициализации.Добавить(ШагИнициализации);

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет значение параметра для инициализации объекта, в случае создания декоратора из типа
//
// Параметры:
//   ЗначениеПараметра - Произвольный - Значение параметра конструктора по типу
//
//  Возвращаемое значение:
//   ПостроительДекоратора - Ссылка на текущий инстанс ПостроительДекоратора
//
Функция ЗначениеПараметраКонструктораПоТипу(ЗначениеПараметра) Экспорт

	Если Не РежимСозданияИзТипа Тогда
		ВызватьИсключение "Значения параметров конструктора по типу задаются только для декораторов типа";
	КонецЕсли;

	ЗначенияПараметровКонструктораПоТипу.Добавить(ЗначениеПараметра);

	Возврат ЭтотОбъект;

КонецФункции

// Получить сконструированный текст сценария будущего декоратора
//
//  Возвращаемое значение:
//   Строка - Текст сценария декоратора
//
Функция ТекстСценария() Экспорт

	РазвернутьЦепочкуДекораторов();

	Слои = ВсеСлои();

	ПроверитьСлои(Слои);

	Лог.Отладка("Тип исходного объекта: %1", ТипЗнч(ИсходныйОбъект));
	Лог.Отладка("Представление исходного объекта: %1", ИсходныйОбъект);
	Лог.Отладка("Количество слоёв: %1", Слои.Количество());

	ТекстСценарияДекоратора = КэшируемыеДанные.ТекстШаблонаОбъектаДекоратора();

	ТекстСценарияДекоратора = СтрЗаменить(ТекстСценарияДекоратора, "// {Область импортов}", ОбластьИмпортов(Слои));
	ТекстСценарияДекоратора = СтрЗаменить(ТекстСценарияДекоратора, "// {Область переменных}", ОбластьПеременных(Слои));
	ТекстСценарияДекоратора = СтрЗаменить(ТекстСценарияДекоратора, "// {Область методов}", ОбластьМетодов(Слои));
	ТекстСценарияДекоратора = СтрЗаменить(ТекстСценарияДекоратора, "// {Инициализация}", ОбластьИнициализации(Слои));

	Возврат ТекстСценарияДекоратора;

КонецФункции

// Сконструировать готовый декоратор по настройкам конструктора Декоратор.
//
// Параметры:
//   ТекстСценария - Строка - Текст сценария декоратора. Если не задан, формируется автоматически.
//
//  Возвращаемое значение:
//   Произвольный - Декоратор над объектом, переданным в конструктор Декоратор
//
Функция Построить(ТекстСценария = Неопределено) Экспорт
	Если ТекстСценария = Неопределено Тогда
		ТекстСценария = ТекстСценария();
	КонецЕсли;
	РазвернутьЦепочкуДекораторов();
	Декоратор = СоздатьДекоратор(ТекстСценария, ВсеСлои());
	Возврат Декоратор;
КонецФункции

// Сконструировать готовый декоратор по настройкам конструктора Декоратор,
//  и зарегистрировать его как новый тип в системе типов
//
// Параметры:
//   ИмяТипа - Строка - Имя, под которым тип будет зарегистрирован в системе
//
Процедура ЗарегистрироватьВСистемеТипов(ИмяТипа) Экспорт
	ЗарегистрироватьДекоратор(ИмяТипа);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Конструктор
//
// Параметры:
//   Объект - Произвольный - Инстанс объекта, над которым нужно создать декоратор
//          - Тип          - Тип объекта, инстанс которого нужно создать и задекорировать
//          - Неопределено - Декоратор создаётся с нуля
//
Процедура ПриСозданииОбъекта(Объект = Неопределено)

	ПереданныйОбъект = Объект;
	ИсходныйОбъект   = Объект;

	РежимСозданияИзТипа = ТипЗнч(ИсходныйОбъект) = Тип("Тип");

	Лог = Логирование.ПолучитьЛог("oscript.lib.decorator");

	Отладка = ЗначениеЗаполнено(ПолучитьПеременнуюСреды("OSCRIPT_DECORATOR_DEBUG"));

	ОбъединятьСлои = Истина;

	ПользовательскиеМетоды               = Новый Массив;
	ПользовательскиеПоля                 = Новый Массив;
	ПользовательскиеИмпорты              = Новый Массив;
	ПользовательскиеШагиИнициализации    = Новый Массив;
	СлужебныеШагиИнициализации           = Новый Массив;
	ПерехватчикиМетодов                  = Новый Массив;
	ЗначенияПараметровКонструктораПоТипу = Новый Массив;

	УнаследованныеСлои = Новый Массив;
	ОбъектВерхнегоСлоя = Неопределено;
	СлоиРазвернуты     = Ложь;

КонецПроцедуры

#Область РаботаСоСлоями

// Разворачивает цепочку вложенных декораторов: исходным объектом становится
// первый в цепочке не-декоратор, а изменения пройденных декораторов
// накапливаются в унаследованных слоях.
//
// Разворачивание отложено до построения: флаг ОбъединятьСлои задаётся
// после конструктора, в текучем стиле.
//
Процедура РазвернутьЦепочкуДекораторов()

	Если СлоиРазвернуты Тогда
		Возврат;
	КонецЕсли;

	СлоиРазвернуты = Истина;

	Если Не ОбъединятьСлои Тогда
		Возврат;
	КонецЕсли;

	РазвернутьЗарегистрированныеТипы();
	РазвернутьИнстансы();

	// У зарегистрированного типа живого инстанса нет, переносить нечего
	Если УнаследованныеСлои.Количество() > 0 И Не ЭтоТип(ПереданныйОбъект) Тогда
		ОбъектВерхнегоСлоя = ПереданныйОбъект;
	КонецЕсли;

КонецПроцедуры

Процедура РазвернутьЗарегистрированныеТипы()

	Пока РежимСозданияИзТипа Цикл

		ИмяТипа = ДекораторКонтекстТиповСлужебный.ИмяЗарегистрированногоТипа(ИсходныйОбъект);

		Если ИмяТипа = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Описание = ДекораторКонтекстТиповСлужебный.ОписаниеИсходногоОбъекта(ИмяТипа);

		Если Описание = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Лог.Отладка("Разворачивается зарегистрированный декоратор ""%1""", ИмяТипа);

		ДобавитьСлоиВНачало(ДекораторКонтекстТиповСлужебный.Рецепт(ИмяТипа));

		ИсходныйОбъект      = Описание.ИсходныйОбъект;
		РежимСозданияИзТипа = Описание.РежимСозданияИзТипа;

		// Параметры конструктора относятся к исходному объекту, а не к декоратору,
		// поэтому наследуются - но только если пользователь не задал свои.
		Если ЗначенияПараметровКонструктораПоТипу.Количество() = 0
			И Описание.ЗначенияПараметровКонструктораПоТипу <> Неопределено Тогда
			ЗначенияПараметровКонструктораПоТипу = Описание.ЗначенияПараметровКонструктораПоТипу;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура РазвернутьИнстансы()

	Если РежимСозданияИзТипа Тогда
		Возврат;
	КонецЕсли;

	Пока Истина Цикл

		Слои = СлоиДекоратора.СлоиОбъекта(ИсходныйОбъект);

		Если Слои = Неопределено Тогда
			// Не декоратор, либо декоратор без рецепта - разворачивать нечем
			Прервать;
		КонецЕсли;

		ДобавитьСлоиВНачало(Слои);

		ИсходныйОбъект = ОбработкаДекоратора.ИсходныйОбъект(ИсходныйОбъект);

	КонецЦикла;

КонецПроцедуры

Функция ЭтоТип(Объект)
	Возврат ТипЗнч(Объект) = Тип("Тип");
КонецФункции

Процедура ДобавитьСлоиВНачало(Слои)

	Объединённые = Новый Массив;

	Для Каждого Слой Из Слои Цикл
		Объединённые.Добавить(Слой);
	КонецЦикла;

	Для Каждого Слой Из УнаследованныеСлои Цикл
		Объединённые.Добавить(Слой);
	КонецЦикла;

	УнаследованныеСлои = Объединённые;

КонецПроцедуры

Функция ВсеСлои()

	Результат = Новый Массив;

	Для Каждого Слой Из УнаследованныеСлои Цикл
		Результат.Добавить(Слой);
	КонецЦикла;

	Результат.Добавить(СобственныйСлой());

	Возврат Результат;

КонецФункции

Функция СобственныйСлой()

	Возврат СлоиДекоратора.НовыйСлой(
		ПользовательскиеПоля,
		ПользовательскиеМетоды,
		ПерехватчикиМетодов,
		ПользовательскиеИмпорты,
		ПользовательскиеШагиИнициализации
	);

КонецФункции

Процедура ПроверитьСлои(Слои)

	ИменаИсходногоОбъекта = ИменаИсходногоОбъекта();

	СлоиДекоратора.ПроверитьКонфликты(
		Слои,
		ИменаИсходногоОбъекта.Поля,
		ИменаИсходногоОбъекта.Методы
	);

	Если УнаследованныеСлои.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СлоиДекоратора.ПроверитьОбращенияКИсходномуОбъекту(
		Слои,
		НедоступныеИменаМетодов(Слои, ИменаИсходногоОбъекта.Переименованные)
	);

КонецПроцедуры

// Имена, которых у исходного объекта нет, но которые до объединения слоёв
// были доступны через служебное поле исходного объекта.
Функция НедоступныеИменаМетодов(Слои, ПереименованныеМетоды)

	Результат = Новый Массив;

	Для Каждого Метод Из СлоиДекоратора.ОбъединитьМетоды(Слои) Цикл
		Результат.Добавить(Метод.ИмяМетода());
	КонецЦикла;

	Для Каждого ИмяМетода Из ПереименованныеМетоды Цикл
		Результат.Добавить(ИмяМетода);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имена полей и методов исходного объекта.
//
//  Возвращаемое значение:
//   Структура - Описание имён:
//     * Поля - Массив из Строка - Имена полей
//     * Методы - Массив из Строка - Имена экспортных методов, как они будут в декораторе
//     * Переименованные - Массив из Строка - Имена методов, отличающиеся от имён у исходного объекта
//
Функция ИменаИсходногоОбъекта()

	Результат = Новый Структура("Поля, Методы, Переименованные", Новый Массив, Новый Массив, Новый Массив);

	Если ИсходныйОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Рефлектор = Новый Рефлектор;

	Для Каждого Свойство Из Рефлектор.ПолучитьТаблицуСвойств(ИсходныйОбъект, Истина) Цикл

		Если Константы_Декоратор.ИменаСлужебныхПолей.Найти(Свойство.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.Поля.Добавить(Свойство.Имя);

	КонецЦикла;

	Для Каждого МетодИсходногоОбъекта Из Рефлектор.ПолучитьТаблицуМетодов(ИсходныйОбъект) Цикл

		Если Не МетодИсходногоОбъекта.Экспорт Тогда
			Продолжить;
		КонецЕсли;

		ИмяМетода = ПолучитьИмяМетода(МетодИсходногоОбъекта.Имя);

		Результат.Методы.Добавить(ИмяМетода);

		Если ИмяМетода <> МетодИсходногоОбъекта.Имя Тогда
			Результат.Переименованные.Добавить(ИмяМетода);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

Функция ОбластьИмпортов(Слои)

	УпакованВИсполняемыйФайл = СтрНайти(ТекущийСценарий().Источник, "oscript://") <> 0;

	Если УпакованВИсполняемыйФайл Тогда
		Возврат ""; // Импорты не поддерживаются
	КонецЕсли;

	ОбластьИмпортов = Новый Массив;

	Для Каждого Импорт Из СлоиДекоратора.ОбъединитьИмпорты(Слои) Цикл
		ОбластьИмпортов.Добавить(Импорт.Описание());
	КонецЦикла;

	ОбластьИмпортов.Добавить("#Использовать logos");

	Возврат СтрСоединить(ОбластьИмпортов, Символы.ПС);

КонецФункции

Функция ОбластьПеременных(Слои)

	ОбластьПеременных = Новый Массив();

	ДобавитьДекорируемыеПоля(ОбластьПеременных);
	ДобавитьПоляСлоев(ОбластьПеременных, Слои);

	Возврат СтрСоединить(ОбластьПеременных, Символы.ПС);

КонецФункции

Процедура ДобавитьДекорируемыеПоля(ОбластьПеременных)

	Если ИсходныйОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Рефлектор = Новый Рефлектор;
	Свойства = Рефлектор.ПолучитьТаблицуСвойств(ИсходныйОбъект, Истина);

	Лог.Отладка("Количество свойств: %1", Свойства.Количество());

	Для Каждого Свойство Из Свойства Цикл

		Если Константы_Декоратор.ИменаСлужебныхПолей.Найти(Свойство.Имя) <> Неопределено Тогда
			Продолжить; // Если это декоратор от декоратора то служебные поля не добавляем
		КонецЕсли;

		Поле = Новый Поле(Свойство.Имя);

		Если Свойство.Экспорт Тогда
			Поле.Публичное();
		КонецЕсли;

		Для каждого АннотацияСвойства Из Свойство.Аннотации Цикл

			Аннотация = Новый Аннотация(АннотацияСвойства.Имя);

			Если Не ЗначениеЗаполнено(АннотацияСвойства.Параметры) Тогда

				Поле.Аннотация(Аннотация);

				Продолжить;

			КонецЕсли;

			Для каждого ПараметрАннотации Из АннотацияСвойства.Параметры Цикл

				Аннотация.Параметр(ПараметрАннотации.Значение, ПараметрАннотации.Имя);

			КонецЦикла;

			Поле.Аннотация(Аннотация);

		КонецЦикла;

		ОбластьПеременных.Добавить(Поле.Описание());

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоляСлоев(ОбластьПеременных, Слои)

	Для Каждого Поле Из СлоиДекоратора.ОбъединитьПоля(Слои) Цикл

		ОбластьПеременных.Добавить(Поле.Описание());

	КонецЦикла;

КонецПроцедуры

Функция ОбластьМетодов(Слои)

	ОбластьМетодов = Новый Массив;

	ДобавитьДекорируемыеМетоды(ОбластьМетодов, Слои);
	ДобавитьМетодыСлоев(ОбластьМетодов, Слои);

	Возврат СтрСоединить(ОбластьМетодов, Символы.ПС);

КонецФункции

Функция ОбластьИнициализации(Слои)

	ОбластьИнициализации = Новый Массив;

	Для Каждого СлужебныйШаг Из СлужебныеШагиИнициализации Цикл
		ОбластьИнициализации.Добавить(СлужебныйШаг.Описание());
	КонецЦикла;

	Для Каждого ШагСлоя Из СлоиДекоратора.ОбъединитьШагиИнициализации(Слои) Цикл
		ОбластьИнициализации.Добавить(ШагСлоя.Описание());
	КонецЦикла;

	Возврат СтрСоединить(ОбластьИнициализации, Символы.ПС);

КонецФункции

Процедура ДобавитьДекорируемыеМетоды(ОбластьМетодов, Слои)

	Если ИсходныйОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Рефлектор = Новый Рефлектор;
	МетодыИсходногоОбъекта = Рефлектор.ПолучитьТаблицуМетодов(ИсходныйОбъект);
	Лог.Отладка("Количество методов: %1", МетодыИсходногоОбъекта.Количество());

	Для Каждого МетодИсходногоОбъекта Из МетодыИсходногоОбъекта Цикл

		Если Не МетодИсходногоОбъекта.Экспорт Тогда
			Продолжить;
		КонецЕсли;

		ИмяМетода = ПолучитьИмяМетода(МетодИсходногоОбъекта.Имя);

		Метод = Новый Метод(ИмяМетода)
			.Публичный();

		Для каждого АннотацияИсходногоОбъекта Из МетодИсходногоОбъекта.Аннотации Цикл

			Аннотация = Новый Аннотация(АннотацияИсходногоОбъекта.Имя);

			Если Не ЗначениеЗаполнено(АннотацияИсходногоОбъекта.Параметры) Тогда

				Метод.Аннотация(Аннотация);

				Продолжить;

			КонецЕсли;

			Для каждого ПараметрАннотации Из АннотацияИсходногоОбъекта.Параметры Цикл

				Аннотация.Параметр(ПараметрАннотации.Значение, ПараметрАннотации.Имя);

			КонецЦикла;

			Метод.Аннотация(Аннотация);

		КонецЦикла;

		ИменаПараметров = Новый Массив();

		Для Каждого ПараметрМетода Из МетодИсходногоОбъекта.Параметры Цикл

			ИменаПараметров.Добавить(ПараметрМетода.Имя);

			Параметр = Новый ПараметрМетода(ПараметрМетода.Имя);

			Если ПараметрМетода.ПоЗначению Тогда
				 Параметр.ПоЗначению();
			КонецЕсли;

			Если ПараметрМетода.ЕстьЗначениеПоУмолчанию Тогда
				Параметр.ЗначениеПоУмолчанию(ПараметрМетода.ЗначениеПоУмолчанию);
			КонецЕсли;

			Для каждого АннотацияПараметрМетода Из ПараметрМетода.Аннотации Цикл

				Аннотация = Новый Аннотация(АннотацияПараметрМетода.Имя);

				Если Не ЗначениеЗаполнено(АннотацияПараметрМетода.Параметры) Тогда

					Параметр.Аннотация(Аннотация);

					Продолжить;

				КонецЕсли;

				Для каждого ПараметрАннотации Из АннотацияПараметрМетода.Параметры Цикл

					Аннотация.Параметр(ПараметрАннотации.Значение, ПараметрАннотации.Имя);

				КонецЦикла;

				Параметр.Аннотация(Аннотация);

			КонецЦикла;

			Метод.Параметр(Параметр);

		КонецЦикла;

		Если Не МетодИсходногоОбъекта.ЭтоФункция Тогда
			Метод.ЭтоПроцедура();
		КонецЕсли;

		ШаблонТекстМетода = "%1 Декоратор_ИсходныйОбъект.%2(%3);";

		// Переименование касается только имени обёртки в модуле декоратора:
		// у исходного объекта метод по-прежнему называется по-своему
		ТекстМетода = СтрШаблон(
			ШаблонТекстМетода,
			?(МетодИсходногоОбъекта.ЭтоФункция, "Возврат", ""),
			МетодИсходногоОбъекта.Имя,
			СтрСоединить(ИменаПараметров, ", ")
		);

		Метод.ТелоМетода(ТекстМетода);

		НовыйМетод = Метод.Описание();

		НовыйМетод = СтрЗаменить(
			НовыйМетод,
			"// {Декоратор_СинхронизироватьПоляПеред}",
			"ОбработкаДекоратора.СинхронизироватьПоля(ЭтотОбъект, Декоратор_ИсходныйОбъект);"
		);

		НовыйМетод = СтрЗаменить(
			НовыйМетод,
			"// {Декоратор_СинхронизироватьПоляПосле}",
			"ОбработкаДекоратора.СинхронизироватьПоля(Декоратор_ИсходныйОбъект, ЭтотОбъект);"
		);

		ДобавитьПерехватчикиМетода(ИмяМетода, НовыйМетод, Слои);

		ОбластьМетодов.Добавить(НовыйМетод);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьМетодыСлоев(ОбластьМетодов, Слои)

	Для Каждого Метод Из СлоиДекоратора.ОбъединитьМетоды(Слои) Цикл

		НовыйМетод = Метод.Описание();

		// Для будущих археологов, если вы подумаете что нужно тут добавить
		// ОбработкаДекоратора.СинхронизироватьПоля(Декоратор_ИсходныйОбъект, ЭтотОбъект);
		// то проверьте что работает АктивнаяЗапись в библиотеки entity
		// сейчас этого куска нет потому что при его наличии в декораторе задавятся поля
		// декоратора которые были заполнены не через методы, а просто установкой свойств.
		НовыйМетод = СтрЗаменить(НовыйМетод, "// {Декоратор_СинхронизироватьПоляПеред}", "");

		НовыйМетод = СтрЗаменить(
			НовыйМетод,
			"// {Декоратор_СинхронизироватьПоляПосле}",
			"ОбработкаДекоратора.СинхронизироватьПоля(ЭтотОбъект, Декоратор_ИсходныйОбъект);"
		);

		ДобавитьПерехватчикиМетода(Метод.ИмяМетода(), НовыйМетод, Слои);

		ОбластьМетодов.Добавить(НовыйМетод);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПерехватчикиМетода(ИмяМетода, ТекстМетода, Слои)

	ТекстыПерехватчиков = СлоиДекоратора.ТелаПерехватчиков(Слои, ИмяМетода);

	ЗаменяемаяСтрокаПеред = "// {Декоратор_ПередВызовомМетода}";
	ЗаменяемаяСтрокаПосле = "// {Декоратор_ПослеВызоваМетода}";

	ЗаменяемаяСтрокаПослеИсключения          = "// {Декоратор_ПослеВызоваИсключения}";
	ЗаменяемаяСтрокаПередСинхронизациейПолей = "// {Декоратор_ПередСинхронизациейПолей}";

	ТекстМетода = СтрЗаменить(
		ТекстМетода,
		ЗаменяемаяСтрокаПеред,
		СтрСоединить(ТекстыПерехватчиков.Получить(ТипыПерехватчиковМетода.Перед), Символы.ПС)
	);

	ТекстМетода = СтрЗаменить(
		ТекстМетода,
		ЗаменяемаяСтрокаПосле,
		СтрСоединить(ТекстыПерехватчиков.Получить(ТипыПерехватчиковМетода.После), Символы.ПС)
	);

	ТекстМетода = СтрЗаменить(
		ТекстМетода,
		ЗаменяемаяСтрокаПослеИсключения,
		СтрСоединить(ТекстыПерехватчиков.Получить(ТипыПерехватчиковМетода.ПослеВызоваИсключения), Символы.ПС)
	);

	ТекстМетода = СтрЗаменить(
		ТекстМетода,
		ЗаменяемаяСтрокаПередСинхронизациейПолей,
		СтрСоединить(ТекстыПерехватчиков.Получить(ТипыПерехватчиковМетода.ПередСинхронизациейПолей), Символы.ПС)
	);

КонецПроцедуры

Функция ПолучитьИмяМетода(Знач ИмяМетода)
	ВозвращаемоеЗначение = ИмяМетода;
	ШаблонНовогоИмени = "_%1";

	НедопустимыеИмена = Новый Массив;
	НедопустимыеИмена.Добавить("найти");
	НедопустимыеИмена.Добавить("find");
	НедопустимыеИмена.Добавить("присозданииобъекта");
	НедопустимыеИмена.Добавить("onobjectcreation");

	Если НЕ НедопустимыеИмена.Найти(Нрег(ИмяМетода)) = Неопределено Тогда
		ВозвращаемоеЗначение = СтрШаблон(ШаблонНовогоИмени, ИмяМетода);
	КонецЕсли;

	Возврат ВозвращаемоеЗначение;
КонецФункции

Функция СоздатьДекоратор(ТекстСценария, Слои)

	Лог.Отладка(ТекстСценария);

	Если Отладка = Истина Тогда
		ИмяВременногоФайла = ВременныеФайлы.НовоеИмяФайла("os");
		ЗаписьТекста = Новый ЗаписьТекста();
		ЗаписьТекста.Открыть(ИмяВременногоФайла);
		ЗаписьТекста.Записать(ТекстСценария);
		ЗаписьТекста.Закрыть();
		Декоратор = ЗагрузитьСценарий(ИмяВременногоФайла);
	Иначе
		Декоратор = ЗагрузитьСценарийИзСтроки(ТекстСценария);
	КонецЕсли;

	ИнстансИсходногоОбъекта = Неопределено;
	Если РежимСозданияИзТипа Тогда
		ИнстансИсходногоОбъекта = Новый(ИсходныйОбъект, ЗначенияПараметровКонструктораПоТипу);
	Иначе
		ИнстансИсходногоОбъекта = ИсходныйОбъект;
	КонецЕсли;

	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Декоратор, Константы_Декоратор.Поле_ИнстансОбъекта, ИнстансИсходногоОбъекта);

	Для Каждого Поле Из СлоиДекоратора.ОбъединитьПоля(Слои) Цикл

		ОписаниеЗначения = Поле.ОписаниеЗначенияПоУмолчанию();

		Если ОписаниеЗначения.ЕстьЗначениеПоУмолчанию Тогда
			Рефлектор.УстановитьСвойство(Декоратор, ОписаниеЗначения.ИмяПоля, ОписаниеЗначения.ЗначениеПоУмолчанию);
		КонецЕсли;

	КонецЦикла;

	ОбработкаДекоратора.СинхронизироватьПоля(ИнстансИсходногоОбъекта, Декоратор);

	// Развёрнутый декоратор в цепочке вызовов больше не участвует,
	// поэтому его живое состояние переносится в построенный декоратор.
	ОбработкаДекоратора.СинхронизироватьПоля(ОбъектВерхнегоСлоя, Декоратор);

	УстановитьРецепт(Декоратор, Слои, Рефлектор);

	Возврат Декоратор;

КонецФункции

Процедура УстановитьРецепт(Декоратор, Слои, Рефлектор)

	Если Не ОбъединятьСлои Тогда
		// Без рецепта следующий построитель вложит этот декоратор, как раньше
		Возврат;
	КонецЕсли;

	Попытка
		Рефлектор.УстановитьСвойство(Декоратор, Константы_Декоратор.Поле_Рецепт, Слои);
	Исключение
		Лог.Предупреждение(
			"В тексте сценария нет поля %1, рецепт декоратора не сохранён."
			+ " Декораторы над этим объектом будут строиться вложенными.",
			Константы_Декоратор.Поле_Рецепт
		);
	КонецПопытки;

КонецПроцедуры

Процедура ЗарегистрироватьДекоратор(ИмяТипа)

	РазвернутьЦепочкуДекораторов();

	Слои = ВсеСлои();

	ДекораторКонтекстТиповСлужебный.УстановитьИнстансИсходногоОбъекта(
		ИмяТипа,
		РежимСозданияИзТипа,
		ИсходныйОбъект,
		ЗначенияПараметровКонструктораПоТипу
	);

	// Служебные шаги пересобираются, а не дописываются: регистрация одного
	// построителя под несколькими именами не должна накапливать шаги.
	СлужебныеШагиИнициализации = Новый Массив;

	СлужебныеШагиИнициализации.Добавить(
		Новый ШагИнициализации(СтрШаблон(
			"%1 = ДекораторКонтекстТиповСлужебный.ИнстансИсходногоОбъекта(""%2"");",
			Константы_Декоратор.Поле_ИнстансОбъекта,
			ИмяТипа
		))
	);

	Если ОбъединятьСлои Тогда

		ДекораторКонтекстТиповСлужебный.УстановитьРецепт(ИмяТипа, Слои);

		СлужебныеШагиИнициализации.Добавить(
			Новый ШагИнициализации(СтрШаблон(
				"%1 = ДекораторКонтекстТиповСлужебный.Рецепт(""%2"");",
				Константы_Декоратор.Поле_Рецепт,
				ИмяТипа
			))
		);

	КонецЕсли;

	ДобавитьШагиЗначенийПолей(ИмяТипа, Слои);

	СлужебныеШагиИнициализации.Добавить(
		Новый ШагИнициализации(СтрШаблон(
			"ОбработкаДекоратора.СинхронизироватьПоля(%1, ЭтотОбъект);",
			Константы_Декоратор.Поле_ИнстансОбъекта
		))
	);

	ТекстСценария = ТекстСценария();

	Лог.Отладка(ТекстСценария);

	ИмяВременногоФайла = ВременныеФайлы.НовоеИмяФайла("os");
	ЗаписьТекста = Новый ЗаписьТекста();
	ЗаписьТекста.Открыть(ИмяВременногоФайла);
	ЗаписьТекста.Записать(ТекстСценария);
	ЗаписьТекста.Закрыть();

	ПодключитьСценарий(ИмяВременногоФайла, ИмяТипа);

	ДекораторКонтекстТиповСлужебный.ЗапомнитьЗарегистрированныйТип(ИмяТипа);

	Если Отладка <> Истина Тогда
		ВременныеФайлы.Удалить();
	КонецЕсли;

КонецПроцедуры

// Начальные значения полей зарегистрированного типа: значения по умолчанию всех
// слоёв плюс снимок живого состояния развёрнутого декоратора - сам он в реестр
// не попадает, поэтому его значения иначе потерялись бы.
Процедура ДобавитьШагиЗначенийПолей(ИмяТипа, Слои)

	ЗначенияПолей = Новый Соответствие;

	Для Каждого Поле Из СлоиДекоратора.ОбъединитьПоля(Слои) Цикл

		ОписаниеЗначения = Поле.ОписаниеЗначенияПоУмолчанию();

		Если ОписаниеЗначения.ЕстьЗначениеПоУмолчанию Тогда
			ЗначенияПолей.Вставить(ОписаниеЗначения.ИмяПоля, ОписаниеЗначения.ЗначениеПоУмолчанию);
		КонецЕсли;

	КонецЦикла;

	Если ОбъектВерхнегоСлоя <> Неопределено Тогда

		Рефлектор = Новый Рефлектор();

		Для Каждого Свойство Из Рефлектор.ПолучитьТаблицуСвойств(ОбъектВерхнегоСлоя, Истина) Цикл

			Если Константы_Декоратор.ИменаСлужебныхПолей.Найти(Свойство.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ЗначенияПолей.Вставить(
				Свойство.Имя,
				Рефлектор.ПолучитьСвойство(ОбъектВерхнегоСлоя, Свойство.Имя)
			);

		КонецЦикла;

	КонецЕсли;

	Для Каждого ЗначениеПоля Из ЗначенияПолей Цикл

		ДекораторКонтекстТиповСлужебный.УстановитьЗначениеПоляПоУмолчанию(
			ИмяТипа,
			ЗначениеПоля.Ключ,
			ЗначениеПоля.Значение
		);

		СлужебныеШагиИнициализации.Добавить(
			Новый ШагИнициализации(СтрШаблон(
				"%1 = ДекораторКонтекстТиповСлужебный.ЗначениеПоляПоУмолчанию(""%2"", ""%1"");",
				ЗначениеПоля.Ключ,
				ИмяТипа
			))
		);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
