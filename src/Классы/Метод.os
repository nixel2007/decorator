#Использовать "../internal"

#Область ОписаниеПеременных

Перем Имя;        // Имя метода
Перем Аннотации;  // Аннотации метода
Перем Тело;       // Тело метода
Перем Параметры;  // Параметры метода
Перем Публичный;  // Экспортный метод
Перем ЭтоФункция; // Этот метод функция

#КонецОбласти

// Конструктор
//
// Параметры:
//   ИмяМетода - Строка - Имя создаваемого метода
//
Процедура ПриСозданииОбъекта(ИмяМетода)

	Имя = ИмяМетода;

	Аннотации  = Новый Массив;
	Параметры  = Новый Массив;
	Тело       = "";
	Публичный  = Ложь;
	ЭтоФункция = Истина;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Добавляет аннотацию метода
//
// Параметры:
//   Аннотация - Аннотация - Добавляемая аннотация
//
//  Возвращаемое значение:
//   Метод - Ссылка на текущий инстанс Метод
//
Функция Аннотация(Аннотация) Экспорт

	Аннотации.Добавить(Аннотация);
	
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает тело метода
//
// Параметры:
//   ТелоМетода - Строка - Устанавливаемое тело метода
//
//  Возвращаемое значение:
//   Метод - Ссылка на текущий инстанс Метод
//
Функция ТелоМетода(ТелоМетода) Экспорт
	
	Тело = ТелоМетода;

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет параметр метода
//
// Параметры:
//   Параметр - ПараметрМетода - Добавляемый параметр метода
//
//  Возвращаемое значение:
//   Метод - Ссылка на текущий инстанс Метод
//
Функция Параметр(Параметр) Экспорт
	
	Параметры.Добавить(Параметр);

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает экспорт метода
//
//  Возвращаемое значение:
//   Метод - Ссылка на текущий инстанс Метод
//
Функция Публичный() Экспорт

	Публичный = Истина;

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает признак того что этот метод Процедура
//
//  Возвращаемое значение:
//   Метод - Ссылка на текущий инстанс Метод
//
Функция ЭтоПроцедура() Экспорт

	ЭтоФункция = Ложь;

	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Имя метода
//
//  Возвращаемое значение:
//   Строка - Имя метода
//
Функция ИмяМетода() Экспорт
	Возврат Имя;
КонецФункции

// Возвращает текст тела метода, как его задал пользователь.
//
//  Возвращаемое значение:
//   Строка - Тело метода
//
Функция ТекстТела() Экспорт
	Возврат Тело;
КонецФункции

// Признак того, что метод - функция
//
//  Возвращаемое значение:
//   Булево - Истина, если метод возвращает значение
//
Функция ВозвращаетЗначение() Экспорт
	Возврат ЭтоФункция;
КонецФункции

// Выражение вызова метода модуля декоратора с параметрами этого метода
//
// Параметры:
//   ИмяВызываемогоМетода - Строка - Имя вызываемого метода
//
//  Возвращаемое значение:
//   Строка - Выражение вызова, например "ДекораторВнутренний_Метод(Параметр1, Параметр2)"
//
Функция ВыражениеВызова(ИмяВызываемогоМетода) Экспорт
	Возврат СтрШаблон("%1(%2)", ИмяВызываемогоМетода, СтрСоединить(ИменаПараметров(), ", "));
КонецФункции

// Строковое представление метода
//
// Параметры:
//   ИмяВызываемогоМетода - Строка - Метод модуля декоратора, который обёртка вызывает с параметрами
//                                   этого метода. Если не задан, обёртка вызывает внутренний метод.
//
//  Возвращаемое значение:
//   Строка - Строковое представление метода
//
Функция Описание(ИмяВызываемогоМетода = Неопределено) Экспорт

	ОписаниеПараметров = Новый Массив();

	Для Каждого Параметр Из Параметры Цикл

		ОписаниеПараметров.Добавить(
			Параметр.Описание()
		);

	КонецЦикла;

	НовыйМетод = КэшируемыеДанные.ТекстШаблонаПользовательскогоМетода();

	НовыйМетод = СтрЗаменить(НовыйМетод, "// {Декоратор_ВыполняемаяСтрока}", СтрокаВызова(ИмяВызываемогоМетода));
	НовыйМетод = ЗаполнитьВидМетода(НовыйМетод);

	СтрокаАннотацийМетода    = АннотацииМенеджер.ОписаниеАннотаций(Аннотации);
	ОписаниеПараметровМетода = СтрСоединить(ОписаниеПараметров, ", ");

	НовыйМетод = СтрЗаменить(НовыйМетод, "// {АннотацияМетода}", СтрокаАннотацийМетода);
	НовыйМетод = СтрЗаменить(НовыйМетод, "Декоратор_ИмяМетода", Имя);
	НовыйМетод = СтрЗаменить(НовыйМетод, "ДекораторВнутренний_ИмяМетода", "ДекораторВнутренний_" + Имя);
	НовыйМетод = СтрЗаменить(НовыйМетод, "Декоратор_ОписаниеПараметровМетода", ОписаниеПараметровМетода);
	НовыйМетод = СтрЗаменить(НовыйМетод, "// {Декоратор_ТекстМетода}", Тело);
	НовыйМетод = СтрЗаменить(НовыйМетод, "// {Экспорт}", ?(Публичный, "Экспорт", ""));

	Возврат НовыйМетод;

КонецФункции

// Строковое представление звена цепочки перехватчиков метода, см. СлоиДекоратора.ЗвеньяПерехватчиков.
//
// Звено - приватный метод того же вида, что и сам метод: функция или процедура.
// Оно вызывается только из декоратора и со всеми параметрами, поэтому параметры в нём
// без значений по умолчанию и аннотаций, а передаются по ссылке - изменения доходят
// до вызывающего так же, как через сам метод.
//
// Параметры:
//   ИмяЗвена - Строка - Имя метода звена
//   ИмяВызываемогоМетода - Строка - см. Описание
//
//  Возвращаемое значение:
//   Строка - Строковое представление звена
//
Функция ОписаниеЗвена(ИмяЗвена, ИмяВызываемогоМетода = Неопределено) Экспорт

	НовоеЗвено = КэшируемыеДанные.ТекстШаблонаЗвенаМетода();

	НовоеЗвено = СтрЗаменить(НовоеЗвено, "// {Декоратор_ВыполняемаяСтрока}", СтрокаВызова(ИмяВызываемогоМетода));
	НовоеЗвено = ЗаполнитьВидМетода(НовоеЗвено);

	НовоеЗвено = СтрЗаменить(НовоеЗвено, "// {АннотацияМетода}", "");
	НовоеЗвено = СтрЗаменить(НовоеЗвено, "Декоратор_ИмяМетода", ИмяЗвена);
	НовоеЗвено = СтрЗаменить(НовоеЗвено, "Декоратор_ОписаниеПараметровМетода", СтрСоединить(ИменаПараметров(), ", "));
	НовоеЗвено = СтрЗаменить(НовоеЗвено, "// {Экспорт}", "");

	Возврат НовоеЗвено;

КонецФункции

// Строковое представление метода, в который вынесено тело перехватчика "Вместо".
//
// Это приватный метод того же вида и с теми же параметрами, что и сам метод, поэтому
// в теле перехватчика работает обычный Возврат: он возвращает результат метода
// и не пропускает ни перехватчики "После", ни синхронизацию полей.
//
// Параметры:
//   ИмяМетодаВместо - Строка - Имя метода перехватчика
//   ТелоВместо - Строка - Тело перехватчика
//
//  Возвращаемое значение:
//   Строка - Строковое представление метода перехватчика
//
Функция ОписаниеМетодаВместо(ИмяМетодаВместо, ТелоВместо) Экспорт

	Отступ = Символы.ПС + Символы.Таб;

	Возврат Символы.ПС
		+ ?(ЭтоФункция, "Функция ", "Процедура ") + ИмяМетодаВместо
		+ "(" + СтрСоединить(ИменаПараметров(), ", ") + ")"
		+ Отступ + СтрЗаменить(ТелоВместо, Символы.ПС, Отступ)
		+ Символы.ПС + ?(ЭтоФункция, "КонецФункции", "КонецПроцедуры")
		+ Символы.ПС;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаполнитьВидМетода(Знач ТекстМетода)

	Если ЭтоФункция Тогда

		ТекстМетода = СтрЗаменить(ТекстМетода, "{Функция}", "Функция");
		ТекстМетода = СтрЗаменить(ТекстМетода, "{КонецФункции}", "КонецФункции");

		ТекстМетода = СтрЗаменить(
			ТекстМетода,
			"// {Декоратор_ВозвращаемоеЗначение}",
			"Возврат Декоратор_ВозвращаемоеИзМетодаЗначение;"
		);

	Иначе

		ТекстМетода = СтрЗаменить(ТекстМетода, "{Функция}", "Процедура");
		ТекстМетода = СтрЗаменить(ТекстМетода, "{КонецФункции}", "КонецПроцедуры");

	КонецЕсли;

	Возврат ТекстМетода;

КонецФункции

Функция ИменаПараметров()

	Результат = Новый Массив;

	Для Каждого Параметр Из Параметры Цикл
		Результат.Добавить(Параметр.Имя());
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СтрокаВызова(Знач ИмяВызываемогоМетода)

	Если ИмяВызываемогоМетода = Неопределено Тогда
		ИмяВызываемогоМетода = "ДекораторВнутренний_" + Имя;
	КонецЕсли;

	ШаблонВыполняемаяСтрока = "%1;";

	Если ЭтоФункция Тогда
		ШаблонВыполняемаяСтрока = "Декоратор_ВозвращаемоеИзМетодаЗначение = " + ШаблонВыполняемаяСтрока;
	КонецЕсли;

	Возврат СтрШаблон(ШаблонВыполняемаяСтрока, ВыражениеВызова(ИмяВызываемогоМетода));

КонецФункции

#КонецОбласти
