// Имя поля, в котором хранится ссылка на исходный объект.
Перем Поле_ИнстансОбъекта Экспорт;

// Имя поля, в котором хранится лог декоратора.
Перем Поле_Лог Экспорт;

// Имя поля, в котором хранится рецепт декоратора - массив слоёв изменений,
// от внутреннего слоя к внешнему.
Перем Поле_Рецепт Экспорт;

// Имя поля, в котором декоратор хранит имена полей, общих с исходным объектом,
// см. ОбработкаДекоратора.СинхронизироватьПоля.
Перем Поле_ОбщиеПоля Экспорт;

// Массив имён служебных полей декоратора.
// Хранится готовым массивом, а не собирается функцией: используется
// в ОбработкаДекоратора.СинхронизироватьПоля, которая вызывается
// на каждом вызове каждого метода декоратора.
Перем ИменаСлужебныхПолей Экспорт;

Поле_ИнстансОбъекта = "Декоратор_ИсходныйОбъект";
Поле_Лог            = "Декоратор_Лог";
Поле_Рецепт         = "Декоратор_Рецепт";
Поле_ОбщиеПоля      = "Декоратор_ОбщиеПоля";

ИменаСлужебныхПолей = Новый Массив;
ИменаСлужебныхПолей.Добавить(Поле_ИнстансОбъекта);
ИменаСлужебныхПолей.Добавить(Поле_Лог);
ИменаСлужебныхПолей.Добавить(Поле_Рецепт);
ИменаСлужебныхПолей.Добавить(Поле_ОбщиеПоля);
