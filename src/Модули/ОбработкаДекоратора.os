#Использовать reflector

Перем Рефлектор;

// Проверяет, что объект является декоратором, построенным этой библиотекой.
//
// Параметры:
//   Объект - Произвольный - Проверяемый объект
//
//  Возвращаемое значение:
//   Булево - Истина, если объект - декоратор
//
Функция ЭтоДекоратор(Объект) Экспорт

	Возврат ЕстьСвойство(Объект, Константы_Декоратор.Поле_ИнстансОбъекта);

КонецФункции

// Получает объект, вокруг которого построен декоратор.
//
// Параметры:
//   Декоратор - Произвольный - Декоратор, у которого нужно получить обёрнутый объект
//
//  Возвращаемое значение:
//   - Произвольный - обёрнутый объект
//   - Неопределено - объект не является декоратором либо декоратор построен
//     без исходного объекта
//
Функция ИсходныйОбъект(Декоратор) Экспорт

	Если Не ЭтоДекоратор(Декоратор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Рефлектор.ПолучитьСвойство(Декоратор, Константы_Декоратор.Поле_ИнстансОбъекта);

КонецФункции

// Получает тип объекта, вокруг которого построен декоратор (рекурсивно).
//
// Параметры:
//   Декоратор - Произвольный - Объект, у которого нужно найти исходный тип объекта
//
//  Возвращаемое значение:
//   Тип - Исходный тип объекта
//
Функция ИсходныйТип(Декоратор) Экспорт

	Если Не ЭтоДекоратор(Декоратор) Тогда
		Возврат ТипЗнч(Декоратор);
	КонецЕсли;

	Возврат ИсходныйТип(ИсходныйОбъект(Декоратор));

КонецФункции

// Синхронизировать значения экспортных полей двух объектов.
//
// Параметры:
//   ИсходныйОбъект - Произвольный - Источник значений свойств
//   Потребитель - Произвольный - Получатель значений свойств
//
Процедура СинхронизироватьПоля(ИсходныйОбъект, Потребитель) Экспорт

	Если Не ЗначениеЗаполнено(ИсходныйОбъект)
		Или Не ЗначениеЗаполнено(Потребитель) Тогда
		Возврат;
	КонецЕсли;

	ИменаПолейДекоратора = Константы_Декоратор.ИменаСлужебныхПолей;

	СвойстваИсходногоОбъекта = ТаблицаСвойствОбъекта(ИсходныйОбъект);
	СвойстваПотребителя      = ТаблицаСвойствОбъекта(Потребитель);
	
	Для Каждого Свойство Из СвойстваИсходногоОбъекта Цикл
		
		ИмяСвойства = Свойство.Имя;
		
		Если ИменаПолейДекоратора.Найти(ИмяСвойства) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если СвойстваПотребителя.Найти(ИмяСвойства, "Имя") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеСвойства = Рефлектор.ПолучитьСвойство(ИсходныйОбъект, ИмяСвойства);
		Рефлектор.УстановитьСвойство(Потребитель, ИмяСвойства, ЗначениеСвойства);
	
	КонецЦикла;

КонецПроцедуры

// Проверяет наличие свойства у объекта.
// Рефлектор выбрасывает исключение на Неопределено и примитивных значениях,
// поэтому проверка обёрнута в Попытку.
//
// Параметры:
//   Объект - Произвольный - Проверяемый объект
//   ИмяСвойства - Строка - Имя искомого свойства
//
//  Возвращаемое значение:
//   Булево - Истина, если свойство есть
//
Функция ЕстьСвойство(Объект, ИмяСвойства)

	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Свойства = ТаблицаСвойствОбъекта(Объект);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Свойства.Найти(ИмяСвойства, "Имя") <> Неопределено;

КонецФункции

// Возвращает таблицу свойств объекта, включая неэкспортные.
// Для нативных объектов движок при включённом флаге неэкспортных свойств
// возвращает пустую таблицу, поэтому она перечитывается без флага.
//
// Параметры:
//   Объект - Произвольный - Отражаемый объект
//
//  Возвращаемое значение:
//   ТаблицаЗначений - Таблица свойств объекта
//
Функция ТаблицаСвойствОбъекта(Объект)

	Таблица = Рефлектор.ПолучитьТаблицуСвойств(Объект, Истина);

	Если Таблица.Количество() = 0 Тогда
		Таблица = Рефлектор.ПолучитьТаблицуСвойств(Объект);
	КонецЕсли;

	Возврат Таблица;

КонецФункции

// #Область Инициализация

Рефлектор = Новый Рефлектор();

// #КонецОбласти
