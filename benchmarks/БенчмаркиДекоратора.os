#Использовать decorator
#Использовать "../tests/fixtures"

// Замеры построения декоратора, вызова его метода и создания экземпляра
// зарегистрированного типа: один или три слоя, в каждом - без перехватчиков,
// "Перед" и "После" или ещё и "Вместо".

&Параметры(1, 3)
Перем КоличествоСлоев Экспорт; // Число - Сколько слоёв декоратора строится над объектом

&Параметры("Нет", "ПередПосле", "Вместо")
Перем Перехватчики Экспорт; // Строка - Какие перехватчики есть в каждом слое

Перем Декоратор; // Произвольный - Декоратор, метод которого вызывается в замере вызова

Перем ИмяТипа; // Строка - Зарегистрированный тип, экземпляр которого создаётся в замере создания

&ПередКаждымКейсом
Процедура Подготовить(Контекст) Экспорт

	ПроверитьИсточникДекоратора();

	Декоратор = ПостроитьДекоратор();
	ИмяТипа   = ЗарегистрироватьТип();

КонецПроцедуры

&Бенчмарк
Процедура Построение() Экспорт
	ПостроитьДекоратор();
КонецПроцедуры

&Бенчмарк
Процедура Вызов() Экспорт
	Декоратор.ТестоваяФункция();
КонецПроцедуры

&Бенчмарк
Процедура СозданиеЭкземпляра() Экспорт
	Экземпляр = Новый(ИмяТипа);
КонецПроцедуры

Функция ПостроитьДекоратор()

	Объект        = Новый МойКласс;
	ОсталосьСлоев = КоличествоСлоев;

	Пока ОсталосьСлоев > 0 Цикл
		Объект        = НовыйСлой(Объект).Построить();
		ОсталосьСлоев = ОсталосьСлоев - 1;
	КонецЦикла;

	Возврат Объект;

КонецФункции

// Каждый следующий слой регистрируется над типом предыдущего: экземпляр типа
// создаёт свой исходный объект, как сущности, зарегистрированные по типу.
Функция ЗарегистрироватьТип()

	Источник      = Тип("МойКласс");
	ИмяНовогоТипа = Неопределено;
	ОсталосьСлоев = КоличествоСлоев;

	Пока ОсталосьСлоев > 0 Цикл
		ИмяНовогоТипа = "ЗамерДекоратора" + СтрЗаменить(Новый УникальныйИдентификатор(), "-", "_");
		НовыйСлой(Источник).ЗарегистрироватьВСистемеТипов(ИмяНовогоТипа);
		Источник      = Тип(ИмяНовогоТипа);
		ОсталосьСлоев = ОсталосьСлоев - 1;
	КонецЦикла;

	Возврат ИмяНовогоТипа;

КонецФункции

Функция НовыйСлой(Объект)

	Построитель = Новый ПостроительДекоратора(Объект);

	Если Перехватчики = "Нет" Тогда
		Возврат Построитель;
	КонецЕсли;

	Построитель.Перехватчик(Перехватчик(ТипыПерехватчиковМетода.Перед, "А = 1;"));

	Если Перехватчики = "Вместо" Тогда
		Построитель.Перехватчик(Перехватчик(ТипыПерехватчиковМетода.Вместо, "Возврат Декоратор_ПродолжитьВызов();"));
	КонецЕсли;

	Построитель.Перехватчик(Перехватчик(ТипыПерехватчиковМетода.После, "Б = 2;"));

	Возврат Построитель;

КонецФункции

Функция Перехватчик(ТипПерехватчика, Тело)
	Возврат Новый Перехватчик("ТестоваяФункция").ТипПерехватчика(ТипПерехватчика).Тело(Тело);
КонецФункции

// Без lib.additional из oscript.cfg рядом замер молча пошёл бы по decorator из oscript_modules,
// см. lib/decorator/package-loader.os. РасширениеТипа - из внешней компоненты benchmark.
Процедура ПроверитьИсточникДекоратора()

	КаталогИсходников = НормализованныйПуть(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src"));
	Источник          = НормализованныйПуть(Новый РасширениеТипа(Тип("ПостроительДекоратора")).Источник);

	Если Не СтрНачинаетсяС(Источник, КаталогИсходников) Тогда
		ВызватьИсключение СтрШаблон(
			"Замеряется decorator не из репозитория, а из %1. Проверьте benchmarks/oscript.cfg",
			Источник
		);
	КонецЕсли;

КонецПроцедуры

Функция НормализованныйПуть(Путь)
	Возврат НРег(СтрЗаменить(Новый Файл(Путь).ПолноеИмя, "\", "/"));
КонецФункции

&КоличествоИтераций(15)
Процедура ПриСозданииОбъекта()
КонецПроцедуры
