// Библиотека decorator для замеров - сам репозиторий, а не пакет из oscript_modules.
//
// benchmark выполняет каждый замер в отдельном процессе и подключает там сначала себя,
// а с собой через зависимости - опубликованный decorator. Подключить репозиторий по пути
// после этого нельзя: его классы пропустятся как уже загруженные, и замер молча пойдёт
// по чужой версии. Поэтому каталог benchmarks/lib указан в lib.additional: OneScript ищет
// библиотеки по имени там раньше, чем в oscript_modules, и decorator для всех, включая
// зависимости benchmark, становится этим репозиторием.

Процедура ПриЗагрузкеБиблиотеки(Путь, СтандартнаяОбработка, Отказ)

	СтандартнаяОбработка = Ложь;

	КаталогРепозитория = Новый Файл(ОбъединитьПути(Путь, "..", "..", "..")).ПолноеИмя;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ОбъединитьПути(КаталогРепозитория, "lib.config"));

	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;

		ЭтоКласс = Чтение.ЛокальноеИмя = "class";

		Если Не ЭтоКласс И Чтение.ЛокальноеИмя <> "module" Тогда
			Продолжить;
		КонецЕсли;

		ПутьКФайлу = ОбъединитьПути(КаталогРепозитория, Чтение.ЗначениеАтрибута("file"));
		Имя        = Чтение.ЗначениеАтрибута("name");

		Если ЭтоКласс Тогда
			ДобавитьКласс(ПутьКФайлу, Имя);
		Иначе
			ДобавитьМодуль(ПутьКФайлу, Имя);
		КонецЕсли;

	КонецЦикла;

	Чтение.Закрыть();

КонецПроцедуры
